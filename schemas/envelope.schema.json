{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope",
  "title": "Envelope: the fields every record starts with",
  "description": "Merged into every kind schema by swdb. `x-vocab` names a file in vocab/; `x-reason` is the message shown when the rule fails.",
  "type": "object",
  "properties": {
    "kind": {"type": "string", "x-vocab": "record_kinds"},
    "schema_version": {"type": "string", "enum": ["0.2"]},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "status": {"type": "string", "enum": ["draft", "reviewed", "deprecated"]},
    "deprecated_by": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "kind": {"type": "string", "x-vocab": "provenance_kinds"},
          "description": {"type": "string", "minLength": 1},
          "uri": {"type": ["string", "null"]}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "extensions": {"type": "object"}
  },
  "required": ["kind", "schema_version", "id", "status", "created", "updated", "provenance"],
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "deprecated"}}, "required": ["status"]},
      "then": {
        "x-reason": "a deprecated record must name its replacement in deprecated_by",
        "required": ["deprecated_by"],
        "properties": {
          "deprecated_by": {
            "type": "string",
            "x-reason": "a deprecated record must name its replacement in deprecated_by"
          }
        }
      }
    }
  ]
}
