{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hardware_target",
  "title": "Versioned simulated hardware target",
  "description": "Separate model, interface, backend readiness, configuration, and physical execution host. Updated 2026-09-25.",
  "properties": {
    "kind": {
      "const": "hardware_target"
    },
    "schema_version": {
      "const": "0.4"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "id",
        "revision"
      ]
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "readiness": {
          "enum": [
            "source_supported",
            "built",
            "verified",
            "unavailable"
          ]
        },
        "build_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "uri",
              "sha256"
            ]
          }
        }
      },
      "required": [
        "id",
        "readiness",
        "build_evidence"
      ]
    },
    "execution_host": {
      "type": [
        "string",
        "null"
      ],
      "x-ref": "machine"
    },
    "configuration": {
      "type": "object",
      "minProperties": 1
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "x-ref": "operation"
      }
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "lines": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "uri",
          "path",
          "sha256",
          "lines"
        ]
      }
    }
  },
  "required": [
    "name",
    "model",
    "interface",
    "backend",
    "execution_host",
    "configuration",
    "operations",
    "source_evidence"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "backend": {
            "properties": {
              "readiness": {
                "enum": [
                  "built",
                  "verified"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "backend": {
            "properties": {
              "build_evidence": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
