+ with os.fdopen(fd,'rb') as stream:
+  opened_stat=os.fstat(stream.fileno());opened={k:getattr(opened_stat,k) for k in REPORT_STAT_KEYS}
+  _report_require(opened==before, 'Report opened stat differs')
