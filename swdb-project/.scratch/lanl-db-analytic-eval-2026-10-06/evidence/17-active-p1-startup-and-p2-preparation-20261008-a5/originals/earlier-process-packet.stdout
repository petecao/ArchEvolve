{"argv": ["/usr/bin/timeout", "--signal=TERM", "--kill-after=60s", "60s", "/usr/bin/python3.12", "-I", "-B", "-c", "import datetime,hashlib,json,os\nfrom pathlib import Path\nroot=2258701; allp={}\nfor p in Path('/proc').iterdir():\n if not p.name.isdecimal():continue\n try:\n  if p.stat().st_uid!=114316761:continue\n  st=(p/'stat').read_text().rsplit(')',1)[1].split();allp[int(p.name)]=(p,st)\n except (OSError,ValueError):pass\nselected={root}\nfor _ in range(16):\n add={pid for pid,(_,s) in allp.items() if int(s[1]) in selected};old=len(selected);selected|=add\n if len(selected)==old:break\nrows=[]\nfor pid in sorted(selected):\n if pid not in allp:continue\n p,s=allp[pid]\n try:\n  status={x.split(':',1)[0]:x.split(':',1)[1].strip() for x in (p/'status').read_text().splitlines() if ':' in x};fds=[]\n  for f in (p/'fd').iterdir():\n   try:\n    target=os.readlink(f)\n    if target.startswith('/data/yanruj/EvolveSWDB_runs/lanl17-actual-campaigns-20261007-a5/') and any(x in target for x in ('/records/','/attempts/')):fds.append(target)\n   except OSError:pass\n  rows.append({'pid':pid,'parent_pid':int(s[1]),'comm':(p/'comm').read_text().strip(),'state':s[0],'user_cpu_ticks':int(s[11]),'kernel_cpu_ticks':int(s[12]),'rss_kib':status.get('VmRSS'),'argv_sha256':hashlib.sha256((p/'cmdline').read_bytes()).hexdigest(),'selected_record_or_attempt_fd_paths':fds,'io':(p/'io').read_text()})\n except (OSError,ValueError):pass\nprint(json.dumps({'format':'swdb.lanl17-owned-public-startup-process-original.v1','checked_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'owned_descendants':rows,'scientific_admission':False},sort_keys=True))\n"], "ended_utc": "2026-10-08T17:07:03.675624+00:00", "exit_code": 0, "files": {}, "format": "swdb.lanl17-parent-metadata-action-original.v1", "scientific_admission": false, "sealed": false, "started_utc": "2026-10-08T17:07:03.626877+00:00", "stderr_base64": "", "stdout_base64": ""}
