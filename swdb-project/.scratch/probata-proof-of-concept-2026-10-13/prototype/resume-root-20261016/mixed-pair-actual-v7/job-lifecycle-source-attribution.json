":108,"text":""},{"line":109,"text":""},{"line":110,"text":"def _acquire(candidates, owner, queue, admit):"},{"line":111,"text":"    \"\"\"Queue FIFO; once among the first `admit` live tickets, take the first free candidate. Returns it.\"\"\""},{"line":112,"text":"    candidates[0].parent.mkdir(parents=True, exist_ok=True)"},{"line":113,"text":"    queue.mkdir(parents=True, exist_ok=True)"},{"line":114,"text":"    ticket = queue / f\"{time.time_ns():020d}-{os.getpid()}\""},{"line":115,"text":"    ticket.write_text(f\"owner={owner} pid={os.getpid()}\\n\")"},{"line":116,"text":"    try:"},{"line":117,"text":"        while True:"},{"line":118,"text":"            if ticket.name in _live(queue)[:admit]:"},{"line":119,"text":"                for lock in candidates:"},{"line":120,"text":"                    try:"},{"line":121,"text":"                        lock.mkdir()"},{"line":122,"text":"                        (lock / \"owner\").write_text(f\"owner={owner} pid={os.getpid()} \""},{"line":123,"text":"                                                    f\"since={time.strftime('%Y-%m-%d %H:%M:%S %Z')}\\n\")"},{"line":124,"text":"                        return lock"},{"line":125,"text":"                    except FileExistsError:"},{"line":126,"text":"                        _clear_if_stale(lock)"},{"line":127,"text":"                    except FileNotFoundError:             # nested lock whose holder just released the outer one"},{"line":128,"text":"                        raise RuntimeError(f\"the verifier lock {lock.parent} was released under a nested job\")"},{"line":129,"text":"            time.sleep(POLL_SECONDS)"},{"line":130,"text":"    finally:"},{"line":131,"text":"        ticket.unlink(missing_ok=True)"},{"line":132,"text":""},{"line":133,"text":""},{"line":134,"text":"def _live(queue):"},{"line":135,"text":"    \"\"\"Live tickets in FIFO order; dead waiters' tickets are removed.\"\"\""},{"line":136,"text":"    live = []"},{"line":137,"text":"    for name in sorted(os.listdir(queue)):"},{"line":138,"text":"        try:"},{"line":139,"text":"            pid = int(name.split(\"-\")[1])"},{"line":140,"text":"        except (IndexError, ValueError):"},{"line":141,"text":"            pid = None"},{"line":142,"text":"        if pid is not None and _alive(pid):"},{"line":143,"text":"            live.append(name)"},{"line":144,"text":"        else:"},{"line":145,"text":"            (queue / name).unlink(missing_ok=True)"},{"line":146,"text":"    return live"},{"line":147,"text":""}],"sha256":"35329946b838d80edd842d235ad477b6727d08eeebd66f28a0adc47ecb8bbeb8"},{"bytes":73392,"path":"swdb/cbmc_adapter.py","selected_lines":[{"line":169,"text":"        log = _Log(job.log)"},{"line":170,"text":"        entry = self.library.get(self.contract) or {}"},{"line":171,"text":"        summary_job = job.unit.candidate is None"},{"line":172,"text":"        log.line(f\"adapter: cbmc\\nunit: {job.unit.candidate or 'library summary ' + self.contract} {job.unit.function}\\n\""},{"line":173,"text":"                 f\"contract: {self.contract}\")"},{"line":174,"text":"        tools = self._tools()"},{"line":545,"text":"        out, log, scratch = context[\"out\"], context[\"log\"], Path(job.scratch)"},{"line":546,"text":"        lines, sampled, domain = _domain(built[\"plan\"])"},{"line":547,"text":"        inputs = scratch / \"domain.txt\""},{"line":548,"text":"        inputs.write_text(\"\".join(\" \".join(str(v) for v in line) + \"\\n\" for line in lines))"},{"line":549,"text":"        c_text = tr.prelude() + built[\"logic\"] + code.c_text() + built[\"harness\"]"},{"line":550,"text":"        cxx_text = tr.prelude() + built[\"logic\"] + code.cxx_text() + built[\"harness\"]"},{"line":551,"text":"        paths_ = {\"c\": out / \"differential_c.c\", \"cxx\": out / \"differential_cxx.cc\"}"},{"line":552,"text":"        paths_[\"c\"].write_text(c_text)"},{"line":553,"text":"        paths_[\"cxx\"].write_text(cxx_text)"},{"line":554,"text":"        contex