// Ticket 03 smoke check for SAW (2026-10-14 ET). Usage: saw smoke_saw.saw (reads smoke_saw.bc
// from the working directory). Verifies smoke() for every 32-bit x; the assert becomes a
// safety goal, so the -DBUGGY build must fail with a counterexample (x = 41).
m <- llvm_load_module "smoke_saw.bc";
let smoke_spec = do {
  x <- llvm_fresh_var "x" (llvm_int 32);
  llvm_execute_func [llvm_term x];
};
llvm_verify m "smoke" [] false smoke_spec z3;
