{
  "adapter_edits": [
    {
      "new": "Retained output stays under 128/256 MiB. Lossless caller ingress has an explicit\n512-MiB expanded-memory bound; original full-TU semantics remain unchanged.",
      "old": "Oversize evidence refuses under current 128/256-MiB retained-output caps."
    },
    {
      "new": "def parse_json_roots(raw, *, full_tu=False, expanded_limit=None):\n    need(expanded_limit is None or (full_tu is True and type(expanded_limit) is int and 0 < expanded_limit <= 536870912),\n         \"explicit full-TU expanded ingress bound required\")\n    limit = STAGE_BYTES if expanded_limit is None else expanded_limit\n    need(type(raw) is bytes and 0 < len(raw) <= limit, \"compiler observation exceeds explicit ingress cap\")",
      "old": "def parse_json_roots(raw, *, full_tu=False):\n    need(type(raw) is bytes and 0 < len(raw) <= STAGE_BYTES, \"compiler observation exceeds admitted per-file cap\")"
    },
    {
      "new": "declarations, compiler_capture_pin, full_tu_compressed_bytes, full_tu_expanded_limit):",
      "old": "declarations, compiler_capture_pin):"
    },
    {
      "new": "    need(type(full_tu_compressed_bytes) is int and 0 < full_tu_compressed_bytes <= STAGE_BYTES\n         and type(full_tu_expanded_limit) is int and full_tu_expanded_limit == 536870912\n         and type(full_tu_raw) is bytes and 0 < len(full_tu_raw) <= full_tu_expanded_limit,\n         \"exact bounded lossless caller ingress required\")\n    need(full_tu_compressed_bytes + len(abi_raw) + len(source_bytes) + len(probe_bytes) <= TOTAL_BYTES,",
      "old": "    need(len(full_tu_raw) + len(abi_raw) + len(source_bytes) + len(probe_bytes) <= TOTAL_BYTES,"
    },
    {
      "new": "parse_json_roots(full_tu_raw, full_tu=True, expanded_limit=full_tu_expanded_limit)[0]",
      "old": "parse_json_roots(full_tu_raw, full_tu=True)[0]"
    }
  ],
