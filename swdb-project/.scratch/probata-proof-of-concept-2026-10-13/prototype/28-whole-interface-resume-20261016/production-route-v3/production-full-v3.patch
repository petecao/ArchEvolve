+        inside = " || ".join(ranges) if ranges else "0"
+        counter[0] += 1
+        flag = f"swdb_f{counter[0]}"
+        checks.append(f"({{ int {flag} = 1; for (long long swdb_k = 0; swdb_k < {cap}; ++swdb_k) "
+                      f"if (!({inside}) && {name}[swdb_k] != swdb_old_{name}[swdb_k]) {{ {flag} = 0; break; }} {flag}; }})")
