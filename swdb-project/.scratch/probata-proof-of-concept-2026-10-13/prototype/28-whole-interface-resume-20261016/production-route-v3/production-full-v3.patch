+        return result
+    return json.loads(raw, object_pairs_hook=unique,
+        parse_constant=lambda _: (_ for _ in ()).throw(Refused('nonfinite JSON refused')))
+
+
+def declarations(raw, header):
+    text = raw.decode('utf-8')
+    clean = _MASK.sub(lambda match: re.sub(r'[^\n]', ' ', match.group()), text)
+    depths, depth = [], 0
+    for char in clean:
+        depths.append(depth)
+        depth += (char == '{') - (char == '}')
+    need(depth == 0, 'unbalanced immutable interface header')
+    return [{'file': header, 'line': text.count('\n', 0, match.start('declaration')) + 1,
+             'name': match['name'], 'declaration': ' '.join(match['declaration'].split())}
+            for match in _DEFINITION.finditer(clean) if depths[match.start()] == 0]
+
+
+def policy(library, data):
+    """Recheck entry bytes and return bindings, without granting source admission.
+
+    The library owner selects this entry through normal version/pin machinery.
+    Neither a matching design hash nor this result attests that a compiler ran,
+    a source transformation is correct, or the external receiver premises hold.
+    """
+    need(checked(data), 'unrecognized checked-body contract form')
+    need(data.get('kind') == 'proof_semantics' and type(data.get('formal_frame')) is int and data['formal_frame'] == 1
+         and data.get('target') == 'dx100-mmio' and data.get('version') == '0.2'
+         and type(data.get('sequence')) is int and data['sequence'] == 2,
+         'separate new 0.2 checked-body version required')
+    need(data.get('hardware_interface') == {'id': 'dx100-mmio', 'version': '1.0-e4fc4af',
+        'gem5_commit': COMMIT}, 'immutable MMIO interface identity differs')
+    body = data.get('checked_body')
+    need(type(body) is dict and set(body) == {'design', 'components', 'source_policy', 'choice_budget'},
+         'exact checked-body source and model bindings required')
+    need(body['design'].get('sha256') == DESIGN_SHA, 'reviewed per-call contract design differs')
+    design = document(pinned(library, body['design']))
+    need(type(design.get('calls')) is list and len(design['calls']) == 26
+         and canonical(data.get('calls')) == canonical(design['calls']), 'every exact per-call contract is mandatory')
+    need(data.get('queries') in (None, []) and 'wp' not in data,
+         'checked-body form has no imported query or WP-summary fallback')
+    calls = design['calls']
+    need(len({row['call'] for row in calls}) == 26
+         and sum(len(row['source_declarations']) for row in calls) == 27
+         and sum(len(row['typed_arity_instances']) for row in calls) == 132,
+         'whole interface name/overload/type-arity census differs')
+    need(type(body['choice_budget']) is int and 1 <= body['choice_budget'] <= 256,
+         'bounded independently drawn model choices required')
+    need(type(body['components']) is list and len(body['components']) == 4,
+         'exact four concrete checked model bodies required')
+    seen = set()
+    physical_inputs = [body['design'], body['source_policy']]
+    for row in body['components']:
+        name = Path(row['path']).name
+        need(name in COMPONENTS and name not in seen and row['sha256'] == COMPONENTS[name],
+             'concrete model body identity or census differs')
+        raw = pinned(library, row)
+        need(not re.search(rb'^\s*#\s*include\s*"', raw, re.M), 'unpinned model include refused')
+        seen.add(name)
+        physical_inputs.append(row)
+    source_policy = document(pinned(library, body['source_policy']))
+    need(type(source_policy) is dict and source_policy.get('kind') == SOURCE_KIND,
+         'separate exact whole-source policy binding required')
+    inventory = data.get('declaration_inventory')
+    need(type(inventory) is dict and set(inventory) == {'sources', 'declarations'}
+         and type(inventory['sources']) is list and len(inventory['sources']) == 2,
+         'both complete original headers required')
+    actual, seen_headers = [], set()
+    for row in inventory['sources']:
+        name = Path(row['path']).name
+        need(name in HEADERS and name not in seen_headers and row['sha256'] == HEADERS[name],
+             'immutable original interface header differs')
+        actual.extend(declarations(pinned(library, row), name))
+        seen_headers.add(name)
+        physical_inputs.append(row)
+    key = lambda row: (row['file'], row['line'], row['name'], row['declaration'])
+    need(len(actual) == 27 and len({row['name'] for row in actual}) == 26
+         and sorted(actual, key=key) == sorted(inventory['declarations'], key=key)
+         and {row['name'] for row in actual} == {row['call'] for row in calls},
+         'contract inventory differs from complete immutable interface declarations')
+    rules = data.get('rules')
+    need(type(rules) is list and all(type(row) is dict for row in rules)
+         and len({row.get('id') for row in rules}) == len(rules), 'unique cited/owned rules required')
+    by_id = {row.get('id'): row for row in rules}
+    for name, statement in {**TRUST, **OWNED}.items():
+        row = by_id.get(name)
+        need(type(row) is dict and set(row) == {'id', 'statement', 'assumed', 'record_assumption'}
+             and row['statement'] == statement and row['record_assumption'] is True
+             and type(row['assumed']) is dict and set(row['assumed']) == {'owner'}
+             and type(row['assumed']['owner']) is str and row['assumed']['owner'].strip(),
+             'every call-boundary/runtime trust premise must be explicitly owned and recorded: ' + name)
+        if name in TRUST:
+            need(row['assumed']['owner'] == 'Eric', 'existing visibility/MMIO trust owner differs')
+    for row in calls:
+        contract = row['contract']
+        need(contract['asserted_domain_checks'] and contract['normal_return_state_value_relation']
+             and contract['source_basis'] and set(contract['owned_rules']) == {'compiler', 'mmio', 'numeric_runtime'},
+             'per-call checked domains, values, source basis and owned semantics required')
+    # All other rules must still have exactly one source citation or named owner.
+    for row in rules:
+        need(type(row.get('id')) is str and row['id'] and type(row.get('statement')) is str
+             and row['statement'].strip() and set(row) <= {'id', 'statement', 'cites', 'assumed', 'record_assumption'}
+             and ('cites' in row) != ('assumed' in row), 'malformed checked-body rule')
+        if 'assumed' in row:
+            need(type(row['assumed']) is dict and set(row['assumed']) == {'owner'}
+                 and type(row['assumed']['owner']) is str and row['assumed']['owner'].strip(), 'rule needs its owner')
+        else:
+            cites = row['cites']
+            need(type(cites) is dict and set(cites) == {'gem5_commit', 'path', 'lines'}
+                 and cites['gem5_commit'] == COMMIT and type(cites['path']) is str and cites['path']
+                 and type(cites['lines']) is str and re.fullmatch(r'\d+(-\d+)?(,\s*\d+(-\d+)?)*', cites['lines']),
+                 'rule must cite exact gem5 source and lines')
+    for row in physical_inputs:
+        pinned(library, row)
+    return {'kind': SOURCE_KIND, 'contract_form': KIND, 'design_sha256': DESIGN_SHA, 'design': body['design'],
+        'source_policy': body['source_policy'], 'choice_budget': body['choice_budget'],
+        'components': body['components'], 'contract_names': sorted(row['call'] for row in calls),
+        'source_admission_granted': False, 'WP_summary_supported': False}
+
+
+def check(library, data, error):
+    try:
+        policy(library, data)
+    except (Refused, OSError, ValueError, TypeError, KeyError, AttributeError, UnicodeError) as exc:
+        error('checked_body', str(exc))
+    return []
