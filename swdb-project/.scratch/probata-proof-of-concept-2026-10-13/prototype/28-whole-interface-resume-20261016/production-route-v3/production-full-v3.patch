+                and r["formal_arity"] == binding.get("formal_arity")
+                and r["declaration"] == binding.get("source_declaration")
+                and r["header_sha256"] == binding.get("header_sha256")
+                and r["body_sha256"] == binding.get("header_body_sha256")]
