{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "2026-10-16 ET. Root-selected exact normal CLI plan. Root guard/environment admission remains separate; ownership tokens are never serialized.",
  "properties": {
    "argv": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "cwd": {
      "pattern": "^/",
      "type": "string"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "producer_project": {
      "pattern": "^/",
      "type": "string"
    },
    "python": {
      "pattern": "^/",
      "type": "string"
    },
    "required_count": {
      "const": 1
    },
    "required_skips": {
      "const": 0
    },
    "sequential_workers": {
      "const": 1
    },
    "timeout_seconds": {
      "maximum": 1800,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "python",
    "producer_project",
    "environment",
    "required_skips",
    "sequential_workers",
    "required_count",
    "timeout_seconds",
    "argv",
    "cwd"
  ],
  "type": "object"
}
