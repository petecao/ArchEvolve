      "new": "adapter = module(\"compiler_unit_adapter_v4.py\", ADAPTER_SHA)",
      "old": "adapter = module(\"compiler_unit_adapter_v3.py\", ADAPTER_SHA)"
    },
    {
      "new": "codec = module(\"lossless_gzip_v2.py\", CODEC_SHA)\n    minifier = module(\"strict_minify_v1.py\", MINIFIER_SHA)",
