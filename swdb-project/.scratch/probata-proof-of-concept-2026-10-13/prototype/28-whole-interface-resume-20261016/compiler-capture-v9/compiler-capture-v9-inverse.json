    },
    {
      "new": "recipe[\"caller_ast_phase_seconds\"] = 120\n    recipe[\"other_phase_seconds\"] = 45\n    recipe[\"lossless_caller_stdout\"] = {\"codec\": \"gzip-single-member\", \"expanded_limit\": 2147483648,",
      "old": "recipe[\"lossless_caller_stdout\"] = {\"codec\": \"gzip-single-member\", \"expanded_limit\": 536870912,"
    },
    {
      "new": "\"expanded_memory_is_not_retained_disk_bytes\": True,\n        \"streaming_strict_token_preserving_minification\": True, \"minified_file_limit\": STAGE_BYTES,\n        \"raw_full_DOM_materialized\": False, \"complete_TU_parser_unchanged\": True}",
      "old": "\"expanded_memory_is_not_retained_disk_bytes\": True}"
    },
    {
      "new": "capture = codec.Capture(zlib_module, stdout, expanded_limit=2147483648,",
