    {
      "new": "CODEC_SHA = \"aae4a423216fcdca6b16f9eba370ec4c83615ed61ae79dd4b3d09e3bed1702ef\"\nMINIFIER_SHA = \"c2d1ae801da0393df801dff3acc489f717e10851d70bc40964db53ad8939fe26\"",
