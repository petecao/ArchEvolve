    "full_original_antecedent": "OwnedEffects::world(h,owners,ready) && Owners::active_owner(owners,l) && Owners::active_owner(owners,r) && OwnedEffects::is_ready(ready,l) && OwnedEffects::is_ready(ready,r) && OwnedEffects::header(h,l,bl,nl,cl) && OwnedEffects::header(h,r,br,nr,cr) && Heap::automatic_available(h,24,8,a)",
    "full_original_statement": "\\forall Heap::heap h; \\forall Owners::state owners; \\forall OwnedEffects::phases ready; \\forall integer l,r,a,bl,nl,cl,br,nr,cr; \\forall integer observed; OwnedEffects::world(h,owners,ready) && Owners::active_owner(owners,l) && Owners::active_owner(owners,r) && OwnedEffects::is_ready(ready,l) && OwnedEffects::is_ready(ready,r) && OwnedEffects::header(h,l,bl,nl,cl) && OwnedEffects::header(h,r,br,nr,cr) && Heap::automatic_available(h,24,8,a) ==> (Owners::active_owner(Owners::swap(owners,l,r),observed) && OwnedEffects::is_ready(ready,observed) ==> (\\exists integer size,capacity; OwnedEffects::header(OwnedEffects::swap(h,l,r,a),observed,Owners::buffer(Owners::swap(owners,l,r),observed),size,capacity)))",
