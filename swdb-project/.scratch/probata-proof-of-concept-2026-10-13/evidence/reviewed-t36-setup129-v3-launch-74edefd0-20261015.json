      "\"\"\"2026-10-15 ET. In-profile collection gate and project-context fingerprint.\n\nThis exact source is embedded in a reviewed command JSON, under the existing\nsocket lane and resource watchdogs. It does not grant verifier admission.\n\"\"\"\nimport contextlib,json,os,pathlib,sys\nimport pytest\n\nproject=pathlib.Path(sys.argv[1]).resolve()\noutput=pathlib.Path(sys.argv[2]).resolve()\nexpected=int(sys.argv[3])\ncommand=sys.argv[4:]\nassert command[1:3]==['-m','pytest']\nos.chdir(project)\nclass Count:\n    selected=None\n    @pytest.hookimpl(trylast=True)\n    def pytest_collection_finish(self,session):\n        self.selected=len(session.items)\ncount=Count()\nargs=[x for x in command[3:] if not x.startswith('--junitxml=')]\nwith (output/'collection.log').open('x') as log:\n    with contextlib.redirect_stdout(log),contextlib.redirect_stderr(log):\n        result=int(pytest.main(['--collect-only',*args],plugins=[count]))\n(output/'collection.json').write_text(json.dumps({'cwd':str(project),'expected':expected,'selected':count.selected,'exit_code':result},indent=2)+'\\n')\nif result or count.selected!=expected:\n    raise SystemExit(4)\nfrom swdb import c_lowering,stdlib_provenance\ntool=c_lowering.locate()\nruntime={'cwd':str(project),'lowering_identity':c_lowering.identity(),\n         'runtime':stdlib_provenance.runtime_identity(tool),\n         'scope':'Project-context snapshot; bootstrap snapshot has monorepo cwd. Variant stand-in/optional-parser fixtures retain their own exact method and record contexts.'}\n(output/'project-runtime-provenance.json').write_text(json.dumps(runtime,indent=2,sort_keys=True)+'\\n')\nos.execv(command[0],command)\n",
