{"archive_bytes":7360550,"archive_sha256":"b7d112edd5bcce6bcce0023d2bc834eb2ae1a1c42d7aea44ffa124d649b50bea","boundary":"Primary upstream source explains protocol/name selection. Installed binaries were separately physically pinned; this is not a reproducible-build claim or historical before/after identity.","checksum_origin":"https://ocaml.org/p/why3/1.8.2","date":"2026-10-16 ET","files":[{"bytes":8922,"path":"why3-1.8.2/src/driver/prove_client.ml","selected_source_lines":[{"line":118,"text":"  let cwd = Unix.getcwd () in"},{"line":119,"text":"  Unix.chdir (Filename.get_temp_dir_name ());"},{"line":120,"text":"  let socket_name = (* Filename.concat (Unix.getcwd ())"},{"line":121,"text":"    (\"why3server.\" ^ string_of_int (Unix.getpid ()) ^ \".sock\") *)"},{"line":122,"text":"    Filename.temp_file \"why3server\" \"sock\""},{"line":123,"text":"  in"},{"line":124,"text":"  let exec = Filename.concat libdir \"why3server\" in"},{"line":125,"text":"  let pid ="},{"line":126,"text":"    (* use this version for debugging the C code"},{"line":127,"text":"    Unix.create_process \"valgrind\""},{"line":128,"text":"    [|\"/usr/bin/valgrind\";exec; \"--socket\"; socket_name;"},{"line":129,"text":"      \"--single-client\";"},{"line":130,"text":"      \"-j\"; string_of_int !max_running_provers|]"},{"line":131,"text":"    Unix.stdin Unix.stdout Unix.stderr"}],"sha256":"75de07b3566646ff1507fff694b6faa90caf4fb3bcdece2088cf364cc023d8ca"}],"schema":"why3-primary-source-socket-attribution-1","source_url":"https://why3.gitlabpages.inria.fr/releases/why3-1.8.2.tar.gz"}
