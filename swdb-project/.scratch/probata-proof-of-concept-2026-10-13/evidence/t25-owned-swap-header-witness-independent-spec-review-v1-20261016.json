  "mathematical_review": {
    "form": "For each original universally quantified U(A => (guard => (Q => exists integer size,capacity. Header(size,capacity)))), the new target is exactly U(A => (guard => (Q => Header(w_size,w_capacity)))). Only the inner existential body is instantiated.",
