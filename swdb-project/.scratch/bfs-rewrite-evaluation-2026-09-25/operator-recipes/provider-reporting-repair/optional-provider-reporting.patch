+def provider_reporting(meta, stdout):
+    """Optional usage telemetry cannot replace the canonical proposal outcome."""
+    unavailable = {'reported_cost_usd': None, 'usage': None,
+                   'provider_output_reporting': {'state': 'unavailable', 'provider_state': meta.get('state')}}
+    if meta.get('state') != 'completed':
+        return unavailable
+    try:
+        with stdout.open('rb') as stream:
+            raw = stream.read(10 * 1024**2 + 1)
+        if len(raw) > 10 * 1024**2:
+            raise ValueError('provider telemetry exceeds retained output bound')
+        value = json.loads(raw)
+        if not isinstance(value, dict):
+            raise ValueError('provider telemetry is not a JSON object')
+    except (OSError, ValueError) as exc:
+        unavailable['provider_output_reporting']['reason'] = type(exc).__name__
+        return unavailable
+    return {'reported_cost_usd': value.get('total_cost_usd'), 'usage': value.get('usage'),
+            'provider_output_reporting': {'state': 'available', 'provider_state': meta['state']}}
 
 
