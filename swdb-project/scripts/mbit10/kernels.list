gapbs-sssp-delta   urand-u16-k16 --cachegrind yes
gapbs-cc-afforest  kron-g16-k16  --cachegrind yes
gapbs-cc-afforest  urand-u16-k16 --cachegrind yes
gapbs-cc-sv        kron-g16-k16  --cachegrind yes
gapbs-cc-sv        urand-u16-k16 --cachegrind yes
gapbs-tc-ordered   kron-g16-k16  --cachegrind yes
gapbs-tc-ordered   urand-u16-k16 --cachegrind yes
gapbs-bfs-do       kron-g22-k16  --cachegrind yes --cachegrind-timeout 3600
gapbs-bfs-do       urand-u22-k16 --cachegrind yes --cachegrind-timeout 3600
gapbs-bc-brandes   kron-g22-k16  --cachegrind yes --cachegrind-timeout 3600
gapbs-bc-brandes   urand-u22-k16 --cachegrind yes --cachegrind-timeout 3600
gapbs-sssp-delta   kron-g22-k16  --cachegrind yes --cachegrind-timeout 3600
gapbs-sssp-delta   urand-u22-k16 --cachegrind yes --cachegrind-timeout 3600
gapbs-cc-afforest  kron-g22-k16  --cachegrind yes --cachegrind-timeout 3600
gapbs-cc-afforest  urand-u22-k16 --cachegrind yes --cachegrind-timeout 3600
