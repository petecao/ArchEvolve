# Tickets 12-14, created 2026-09-22: the other gapbs kernels on the four pilot inputs.
# <implementation> <input> [swdb profile options]
# tc on kron-g22-k16: gapbs's serial TCVerifier did not finish in 30 min (2026-09-22), so that
# run records an unverified, incomplete profile after 900 s (the recorded run used these options).
gapbs-bfs-do       kron-g16-k16  --cachegrind yes
gapbs-bfs-do       urand-u16-k16 --cachegrind yes
gapbs-bc-brandes   kron-g16-k16  --cachegrind yes
gapbs-bc-brandes   urand-u16-k16 --cachegrind yes
