{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attribution",
  "title": "Attribution report",
  "description": "Created: 2026-10-11 ET (fine-grained attribution ticket 02; ticket 08 added catalog bounds and the remaining-gain-bound ranking). Two saved estimates split by code origin from a diff of their counted source trees. Derived from estimates; never a timing observation.",
  "properties": {
    "kind": {"const": "attribution"},
    "schema_version": {"const": "0.4"},
    "format": {"const": "swdb.attribution.v1"},
    "baseline_estimate": {"$ref": "#/$defs/estimate_pin"},
    "candidate_estimate": {"$ref": "#/$defs/estimate_pin"},
    "baseline_source": {"$ref": "#/$defs/source_pin"},
    "candidate_source": {"$ref": "#/$defs/source_pin"},
    "target_description": {
      "type": "object", "additionalProperties": false, "required": ["id", "sha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "input": {"$ref": "#/$defs/id"},
    "threads": {"type": "integer", "minimum": 1},
    "evidence_kind": {"enum": ["execution", "contract_fixture"]},
    "catalog": {
      "type": "array",
      "description": "Ticket 05: content hashes of the intrinsic records and typed-library operations that labeled a region.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "id", "sha256"],
        "properties": {
          "kind": {"enum": ["intrinsic", "library_operation"]},
          "id": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "site_finder": {
      "description": "Ticket 08 (2026-10-11 ET): the saved campaign summary iteration whose site-finder regions gave catalog bounds; absent when none was given.",
      "type": "object", "additionalProperties": false, "required": ["campaign_summary", "iteration", "query_sha256", "kernel", "target", "regions"],
      "properties": {
        "campaign_summary": {
          "type": "object", "additionalProperties": false, "required": ["id", "sha256"],
          "properties": {"id": {"$ref": "#/$defs/id", "x-ref": "campaign_summary"}, "sha256": {"$ref": "#/$defs/sha256"}}
        },
        "iteration": {"type": "integer", "minimum": 0},
        "query_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "kernel": {"description": "Ticket 10: the site-finder kernel parameter of the pinned iteration (or summary); null when not recorded.", "type": ["string", "null"]},
        "target": {"description": "Ticket 10: the site-finder target binding (native_cpu, dx100_gem5); null when not recorded.", "type": ["string", "null"]},
        "regions": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "function", "path", "revision", "lines", "entries"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "function": {"type": ["string", "null"]},
              "path": {"type": ["string", "null"]},
              "revision": {"type": ["string", "null"]},
              "lines": {"oneOf": [{"$ref": "#/$defs/lines"}, {"type": "null"}]},
              "entries": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "rewrite_sites": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "baseline_lines", "candidate_lines", "spans", "baseline_regions", "candidate_regions"],
        "properties": {
          "id": {"type": "string", "pattern": "^site\\.[1-9][0-9]*$"},
          "path": {"type": ["string", "null"], "minLength": 1},
          "baseline_lines": {"oneOf": [{"$ref": "#/$defs/lines"}, {"type": "null"}]},
          "candidate_lines": {"oneOf": [{"$ref": "#/$defs/lines"}, {"type": "null"}]},
          "spans": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["path", "baseline_lines", "candidate_lines"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "baseline_lines": {"$ref": "#/$defs/lines"},
                "candidate_lines": {"$ref": "#/$defs/lines"}
              }
            }
          },
          "baseline_regions": {"type": "array", "items": {"type": "string"}},
          "candidate_regions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["side", "region", "origin", "reason", "mixed", "path", "lines", "inlined", "sites", "seconds",
                     "evidence", "matched_region", "resource_floor", "catalog_bound", "headroom"],
        "properties": {
          "side": {"$ref": "#/$defs/side"},
          "region": {"type": "string", "minLength": 1},
          "origin": {"$ref": "#/$defs/origin"},
          "reason": {"enum": ["overlaps_rewrite_site", "no_changed_line", "outside_source_tree", "no_source_location",
                               "offload_command_in_site", "intrinsic_in_site", "library_operation_in_site"]},
          "mixed": {"type": "boolean"},
          "path": {"type": ["string", "null"]},
          "lines": {"oneOf": [{"$ref": "#/$defs/lines"}, {"type": "null"}]},
          "inlined": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["path", "lines"],
              "properties": {"path": {"type": "string", "minLength": 1}, "lines": {"$ref": "#/$defs/lines"}}
            }
          },
          "sites": {"type": "array", "items": {"type": "string"}},
          "seconds": {"$ref": "#/$defs/seconds"},
          "matched_region": {"type": ["string", "null"]},
          "evidence": {
            "type": "array",
            "description": "Ticket 05: every library, intrinsic or offload signal of a region inside a rewrite site, highest precedence first; empty outside sites.",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["origin", "name"],
              "properties": {"origin": {"$ref": "#/$defs/rewrite_origin"}, "name": {"type": "string", "minLength": 1}}
            }
          },
          "last_changed_iteration": {"type": ["integer", "null"], "minimum": 0},
          "resource_floor": {"$ref": "#/$defs/resource_floor"},
          "catalog_bound": {"$ref": "#/$defs/catalog_bound"},
          "headroom": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/headroom"}}
        }
      }
    },
    "groups": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["origin", "baseline_seconds", "candidate_seconds", "baseline_share", "candidate_share", "realized_speedup", "unknown"],
        "properties": {
          "origin": {"$ref": "#/$defs/origin"},
          "baseline_seconds": {"$ref": "#/$defs/seconds"},
          "candidate_seconds": {"$ref": "#/$defs/seconds"},
          "baseline_share": {"$ref": "#/$defs/ratio"},
          "candidate_share": {"$ref": "#/$defs/ratio"},
          "realized_speedup": {"$ref": "#/$defs/ratio"},
          "drift": {"$ref": "#/$defs/ratio"},
          "unknown": {"$ref": "#/$defs/unknown"},
          "origins": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "description": "agent_rewritten group only (ticket 05): its seconds split by the origin of each region inside a rewrite site.",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["origin", "baseline_seconds", "candidate_seconds", "baseline_share", "candidate_share", "unknown"],
              "properties": {
                "origin": {"$ref": "#/$defs/rewrite_origin"},
                "baseline_seconds": {"$ref": "#/$defs/seconds"},
                "candidate_seconds": {"$ref": "#/$defs/seconds"},
                "baseline_share": {"$ref": "#/$defs/ratio"},
                "candidate_share": {"$ref": "#/$defs/ratio"},
                "unknown": {"$ref": "#/$defs/unknown"}
              }
            }
          }
        }
      }
    },
    "whole_program": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline_seconds", "candidate_seconds", "total_speedup", "amdahl_ceiling",
                   "unattributed_threshold", "unattributed_flagged", "unknown"],
      "properties": {
        "baseline_seconds": {"$ref": "#/$defs/seconds"},
        "candidate_seconds": {"$ref": "#/$defs/seconds"},
        "total_speedup": {"$ref": "#/$defs/ratio"},
        "amdahl_ceiling": {"$ref": "#/$defs/ratio"},
        "unattributed_threshold": {"const": 0.1},
        "unattributed_flagged": {"type": ["boolean", "null"]},
        "unknown": {"$ref": "#/$defs/unknown"}
      }
    },
    "this_iteration": {
      "description": "Ticket 06 (F13): the previous accepted candidate -> candidate comparison, present only when one was given. Inside it, `baseline` means the previous accepted candidate.",
      "type": "object", "additionalProperties": false,
      "required": ["iteration", "previous_estimate", "previous_source", "earlier_sources", "rewrite_sites", "regions", "groups", "whole_program"],
      "properties": {
        "iteration": {"type": "integer", "minimum": 2},
        "previous_estimate": {"$ref": "#/$defs/estimate_pin"},
        "previous_source": {"$ref": "#/$defs/source_pin"},
        "earlier_sources": {"type": "array", "items": {"$ref": "#/$defs/source_pin"}},
        "rewrite_sites": {"$ref": "#/properties/rewrite_sites"},
        "regions": {"$ref": "#/properties/regions"},
        "groups": {"$ref": "#/properties/groups"},
        "whole_program": {"$ref": "#/properties/whole_program"}
      }
    },
    "ranking": {"type": "array", "items": {"$ref": "#/$defs/rank"}},
    "ranking_rule": {
      "description": "Ticket 08: how each ranking tier is ordered; the remaining gain bound is an upper limit, never an expected gain.",
      "type": "object", "additionalProperties": false, "required": ["remaining_gain_bound", "floor_headroom", "unknown"],
      "properties": {
        "remaining_gain_bound": {"type": "string", "pattern": "^Upper limit"},
        "floor_headroom": {"type": "string", "minLength": 1},
        "unknown": {"type": "string", "minLength": 1}
      }
    },
    "split_check": {
      "description": "Ticket 09 (2026-10-11 ET, F15, F18, F19, F23): measured region thread-CPU shares from one region_profile per side against the estimated group shares, under the rule fixed before timing; absent when no profiles were given.",
      "type": "object", "additionalProperties": false,
      "required": ["verdict", "rule", "reasons", "profiles", "measured_shares", "gaps", "regions"],
      "properties": {
        "verdict": {"enum": ["passed", "split_unverified"]},
        "rule": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "max_abs_share_gap", "tolerance", "statement", "estimated_share", "measured_share"],
          "properties": {
            "id": {"const": "swdb.split_check.v1"},
            "max_abs_share_gap": {"const": 0.1},
            "tolerance": {"const": 1e-9},
            "statement": {"type": "string", "minLength": 1},
            "estimated_share": {"type": "string", "minLength": 1},
            "measured_share": {"type": "string", "minLength": 1}
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["side", "origin", "reason"],
            "properties": {
              "side": {"$ref": "#/$defs/side"},
              "origin": {"anyOf": [{"enum": ["untouched", "agent_rewritten", "unattributed"]}, {"type": "null"}]},
              "reason": {"enum": ["gap_above_rule", "unknown_estimated_share", "no_measured_time"]}
            }
          }
        },
        "profiles": {
          "type": "object", "additionalProperties": false, "required": ["baseline", "candidate"],
          "properties": {"baseline": {"$ref": "#/$defs/profile_pin"}, "candidate": {"$ref": "#/$defs/profile_pin"}}
        },
        "measured_shares": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["side", "origin", "seconds", "share"],
            "properties": {
              "side": {"$ref": "#/$defs/side"},
              "origin": {"enum": ["untouched", "agent_rewritten", "unattributed"]},
              "seconds": {"type": "number", "minimum": 0},
              "share": {"$ref": "#/$defs/ratio"}
            }
          }
        },
        "gaps": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["side", "origin", "estimated_share", "measured_share", "gap", "within_rule"],
            "properties": {
              "side": {"$ref": "#/$defs/side"},
              "origin": {"enum": ["untouched", "agent_rewritten", "unattributed"]},
              "estimated_share": {"$ref": "#/$defs/ratio"},
              "measured_share": {"$ref": "#/$defs/ratio"},
              "gap": {"type": ["number", "null"]},
              "within_rule": {"type": ["boolean", "null"]}
            }
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["side", "region", "kind", "path", "lines", "origin", "reason", "mixed", "exclusive_lines", "sites", "seconds"],
            "properties": {
              "side": {"$ref": "#/$defs/side"},
              "region": {"type": "string", "minLength": 1},
              "kind": {"type": ["string", "null"]},
              "path": {"type": ["string", "null"]},
              "lines": {"anyOf": [{"$ref": "#/$defs/lines"}, {"type": "null"}]},
              "origin": {"enum": ["untouched", "agent_rewritten", "unattributed"]},
              "reason": {"enum": ["overlaps_rewrite_site", "no_changed_line", "outside_source_tree", "no_source_location"]},
              "mixed": {"type": "boolean"},
              "exclusive_lines": {"type": "array", "items": {"$ref": "#/$defs/lines"}},
              "sites": {"type": "array", "items": {"type": "string"}},
              "seconds": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": ["format", "baseline_estimate", "candidate_estimate", "baseline_source", "candidate_source",
               "target_description", "input", "threads", "evidence_kind", "catalog", "rewrite_sites", "regions", "groups",
               "whole_program", "ranking", "ranking_rule", "identity_sha256"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_pin": {
      "description": "Ticket 09: one side's region_profile, by content hash, with the input, threads and host load recorded with its run.",
      "type": "object", "additionalProperties": false,
      "required": ["id", "sha256", "evaluation", "machine", "workload", "threads", "lane", "load_average", "primary_load_average"],
      "properties": {
        "id": {"$ref": "#/$defs/id", "x-ref": "region_profile"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "evaluation": {"type": ["string", "null"]},
        "machine": {"type": ["string", "null"]},
        "workload": {"$ref": "#/$defs/id"},
        "threads": {"type": "integer", "minimum": 1},
        "lane": {"type": ["string", "null"]},
        "load_average": {"type": ["array", "null"], "items": {"type": "number"}},
        "primary_load_average": {"type": ["array", "null"], "items": {"type": "number"}}
      }
    },
    "seconds": {"type": ["number", "null"], "minimum": 0},
    "ratio": {"type": ["number", "null"], "minimum": 0},
    "side": {"enum": ["baseline", "candidate"]},
    "origin": {"enum": ["untouched", "agent_rewritten", "unattributed", "library_call", "intrinsic", "offload_command"]},
    "rewrite_origin": {"enum": ["offload_command", "intrinsic", "library_call", "agent_rewritten"]},
    "lines": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2},
    "estimate_pin": {
      "type": "object", "additionalProperties": false, "required": ["id", "sha256"],
      "properties": {"id": {"$ref": "#/$defs/id", "x-ref": "estimate"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "source_pin": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "sha256", "artifact_sha256"],
      "properties": {
        "kind": {"enum": ["source_snapshot", "candidate"]},
        "id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "resource_floor": {
      "description": "Ticket 07 (2026-10-11 ET): max(compute bound, useful-bytes bandwidth bound) at the target description's own rates; null with reasons when a count or rate is missing.",
      "type": "object", "additionalProperties": false, "required": ["seconds", "limiting_term", "terms", "missing"],
      "properties": {
        "seconds": {"$ref": "#/$defs/seconds"},
        "limiting_term": {"enum": ["compute_throughput", "streaming_bandwidth", null]},
        "terms": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["model", "in_description", "seconds", "missing"],
            "properties": {
              "model": {"enum": ["compute_throughput", "streaming_bandwidth"]},
              "in_description": {"type": "boolean"},
              "seconds": {"$ref": "#/$defs/seconds"},
              "missing": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "missing": {"type": "array", "items": {"type": "string"}}
      }
    },
    "catalog_bound": {
      "description": "Ticket 08 (2026-10-11 ET, F6, F21, F25): the lowest known estimate among the site-finder-matched entries whose offload mechanism models run on the region's own counts; null with a reason otherwise.",
      "type": "object", "additionalProperties": false,
      "required": ["seconds", "entry", "reason", "mixed", "site_finder_regions", "entries", "missing"],
      "properties": {
        "seconds": {"$ref": "#/$defs/seconds"},
        "entry": {"type": ["string", "null"]},
        "reason": {"enum": ["needs_rewritten_counts", "unknown_catalog_entry", "no_catalog_match", "no_site_finder", null]},
        "mixed": {"type": "boolean"},
        "site_finder_regions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "entries": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["entry", "kind", "content_sha256", "site_finder_regions", "seconds", "reason", "mechanisms", "missing"],
            "properties": {
              "entry": {"type": "string", "minLength": 1},
              "kind": {"type": ["string", "null"]},
              "content_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
              "site_finder_regions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "seconds": {"$ref": "#/$defs/seconds"},
              "reason": {"enum": ["needs_rewritten_counts", "missing_inputs", "no_offload_mechanism", "entry_changed", "not_in_library", null]},
              "mechanisms": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["model", "accounting", "seconds", "missing"],
                  "properties": {
                    "model": {"type": "string", "minLength": 1},
                    "accounting": {"enum": ["resource_bound", "additive_overhead"]},
                    "seconds": {"$ref": "#/$defs/seconds"},
                    "missing": {"type": "array", "items": {"type": "string"}}
                  }
                }
              },
              "missing": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "missing": {"type": "array", "items": {"type": "string"}}
      }
    },
    "headroom": {
      "type": "object", "additionalProperties": false, "required": ["limit", "value", "reason"],
      "properties": {
        "limit": {"enum": ["resource_floor", "catalog_bound"]},
        "value": {"$ref": "#/$defs/ratio"},
        "reason": {"enum": ["unknown_estimate", "unknown_limit", "zero_limit", "needs_rewritten_counts",
                             "unknown_catalog_entry", "no_catalog_match", "no_site_finder", null]}
      }
    },
    "rank": {
      "type": "object", "additionalProperties": false, "required": ["position", "side", "region", "tier", "limit", "value", "reason"],
      "properties": {
        "position": {"type": "integer", "minimum": 1},
        "side": {"const": "candidate"},
        "region": {"type": "string", "minLength": 1},
        "tier": {"enum": ["remaining_gain_bound", "floor_headroom", "unknown"]},
        "limit": {"enum": ["catalog_bound", "resource_floor"]},
        "value": {"$ref": "#/$defs/ratio"},
        "reason": {"enum": ["unknown_estimate", "unknown_limit", "zero_limit", "unknown_share", "zero_total", null]}
      }
    },
    "unknown": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["side", "region", "missing"],
        "properties": {
          "side": {"$ref": "#/$defs/side"},
          "region": {"type": "string", "minLength": 1},
          "missing": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
