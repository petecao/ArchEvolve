{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estimate",
  "description": "Updated: 2026-10-06 ET. Analytic estimates are never timing observations.",
  "properties": {
    "kind": {
      "const": "estimate"
    },
    "schema_version": {
      "const": "0.4"
    },
    "format": {
      "const": "swdb.estimate.v1"
    },
    "basis": {
      "const": "estimated"
    },
    "estimator_version": {
      "type": "string"
    },
    "estimator_variant": {
      "enum": [
        "team",
        "research"
      ]
    },
    "calibration_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "characterization": {
      "$ref": "#/$defs/id"
    },
    "characterization_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_description": {
      "$ref": "#/$defs/id"
    },
    "target_description_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_description_snapshot": {
      "type": "object"
    },
    "target": {
      "$ref": "#/$defs/id"
    },
    "threads": {
      "type": "integer",
      "minimum": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "candidate",
            "implementation"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "input": {
      "$ref": "#/$defs/id"
    },
    "protocol": {
      "$ref": "#/$defs/id"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
          },
          "seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "basis": {
            "const": "estimated"
          },
          "bounds": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string"
                },
                "seconds": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "basis": {
                  "const": "estimated"
                },
                "state": {
                  "enum": [
                    "known",
                    "unknown"
                  ]
                },
                "formula": {
                  "type": "string"
                },
                "inputs": {
                  "type": "object"
                },
                "missing": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "model",
                "seconds",
                "basis",
                "state",
                "formula",
                "inputs",
                "missing",
                "notes"
              ]
            }
          },
          "overheads": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string"
                },
                "seconds": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "basis": {
                  "const": "estimated"
                },
                "state": {
                  "enum": [
                    "known",
                    "unknown"
                  ]
                },
                "formula": {
                  "type": "string"
                },
                "inputs": {
                  "type": "object"
                },
                "missing": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "model",
                "seconds",
                "basis",
                "state",
                "formula",
                "inputs",
                "missing",
                "notes"
              ]
            }
          },
          "limiting_bound": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "enum": [
              "known",
              "unknown"
            ]
          }
        },
        "required": [
          "id",
          "seconds",
          "basis",
          "bounds",
          "overheads",
          "limiting_bound",
          "state"
        ]
      }
    },
    "seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "ratio": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "baseline": {
      "type": [
        "object",
        "null"
      ]
    },
    "verdict": {
      "enum": [
        "estimated_gain",
        "within_error",
        "estimated_no_gain"
      ]
    },
    "error_band": {
      "type": [
        "object",
        "null"
      ]
    },
    "llm_parameters": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_kind": {
      "enum": [
        "execution",
        "contract_fixture"
      ]
    },
    "scope": {
      "type": "object"
    },
    "binding": {
      "type": "object"
    },
    "trials": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "string"
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "estimator_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count_reuse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "counted_target_description_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requested_target_description_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "counted_characterization_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "count_observation_context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "format": {
          "const": "swdb.identical-observation-reuse.v1"
        },
        "state": {
          "enum": [
            "exact_counted_target",
            "identical_observation_policy"
          ]
        },
        "observation_policy_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observation_policy_format": {
          "enum": [
            "swdb.observation-policy.v1",
            null
          ]
        }
      },
      "required": [
        "counted_target_description_sha256",
        "requested_target_description_sha256",
        "counted_characterization_sha256",
        "count_observation_context_sha256",
        "format",
        "state",
        "observation_policy_sha256",
        "notes",
        "observation_policy_format"
      ]
    },
    "parameter_report": {
      "$ref": "#/$defs/parameter_report"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "format",
    "basis",
    "estimator_version",
    "estimator_variant",
    "calibration_sources",
    "characterization",
    "characterization_sha256",
    "target_description",
    "target_description_sha256",
    "target_description_snapshot",
    "target",
    "threads",
    "subject",
    "input",
    "protocol",
    "regions",
    "seconds",
    "ratio",
    "baseline",
    "verdict",
    "error_band",
    "llm_parameters",
    "evidence_kind",
    "scope",
    "binding",
    "protocol_sha256",
    "estimator_sha256"
  ],
  "$defs": {
    "parameter_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "swdb.parameter-sensitivity.v1"
        },
        "basis": {
          "const": "estimated"
        },
        "target_description_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observation_policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "parameter": {
                "type": "string",
                "pattern": "^mechanisms\\[[0-9]+\\]\\.parameters\\..+$"
              },
              "model": {
                "type": "string"
              },
              "value": {
                "const": null
              },
              "basis": {
                "type": "string",
                "x-vocab": "basis"
              },
              "source": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "dependent_bounds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required_for_total": {
                "type": "boolean"
              },
              "priority_rank": {
                "enum": [
                  1,
                  2
                ]
              },
              "impact_rank": {
                "const": null
              },
              "impact_magnitude_seconds": {
                "const": null
              },
              "sensitivity_state": {
                "const": "unknown_reference"
              }
            },
            "required": [
              "parameter",
              "model",
              "value",
              "basis",
              "source",
              "unit",
              "dependent_bounds",
              "required_for_total",
              "priority_rank",
              "impact_rank",
              "impact_magnitude_seconds",
              "sensitivity_state"
            ]
          }
        },
        "sensitivities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "parameter": {
                "type": "string",
                "pattern": "^mechanisms\\[[0-9]+\\]\\.parameters\\..+$"
              },
              "model": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "basis": {
                "type": "string",
                "x-vocab": "basis"
              },
              "source": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "dependent_bounds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required_for_total": {
                "type": "boolean"
              },
              "priority_rank": {
                "enum": [
                  1,
                  2
                ]
              },
              "impact_rank": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "impact_magnitude_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "sensitivity_state": {
                "enum": [
                  "invalid_numeric_reference",
                  "unsupported_numeric_scenario",
                  "requires_fresh_observation",
                  "whole_call_numeric_scenario",
                  "local_components_only"
                ]
              },
              "whole_call_seconds": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "half": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "base": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "double": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  }
                },
                "required": [
                  "half",
                  "base",
                  "double"
                ]
              },
              "component_seconds": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "half": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    }
                  },
                  "base": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    }
                  },
                  "double": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    }
                  }
                },
                "required": [
                  "half",
                  "base",
                  "double"
                ]
              },
              "scenario_values": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "half": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "base": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "double": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "half",
                  "base",
                  "double"
                ]
              },
              "scenario_target_description_sha256": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "half": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "base": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "double": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "half",
                  "base",
                  "double"
                ]
              }
            },
            "required": [
              "parameter",
              "model",
              "value",
              "basis",
              "source",
              "unit",
              "dependent_bounds",
              "required_for_total",
              "priority_rank",
              "impact_rank",
              "impact_magnitude_seconds",
              "sensitivity_state",
              "whole_call_seconds",
              "component_seconds",
              "scenario_values",
              "scenario_target_description_sha256"
            ]
          }
        },
        "structural_missing": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "missing": {
                "type": "string"
              },
              "regions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "formulas": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required_for_total": {
                "const": true
              },
              "parameter_fill_allowed": {
                "const": false
              },
              "impact_rank": {
                "const": null
              },
              "impact_magnitude_seconds": {
                "const": null
              }
            },
            "required": [
              "missing",
              "regions",
              "models",
              "formulas",
              "required_for_total",
              "parameter_fill_allowed",
              "impact_rank",
              "impact_magnitude_seconds"
            ]
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "format",
        "basis",
        "target_description_sha256",
        "observation_policy_sha256",
        "unknowns",
        "sensitivities",
        "structural_missing",
        "notes"
      ]
    }
  }
}
