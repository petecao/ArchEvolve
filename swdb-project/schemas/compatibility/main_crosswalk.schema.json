{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unverified LANL main-database crosswalk v0 (2026-10-06 ET; record kinds synced with swdb.store 2026-10-09 ET)",
  "description": "Slide labels are distinct from SQL identifiers. Null means unseen. Compatibility metadata stays outside records/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "crosswalk_version", "id", "date", "source_deck", "rows", "separable_extension"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "crosswalk_version": {"const": 0},
    "id": {"const": "lanl-main-crosswalk-v0"},
    "date": {"$ref": "#/$defs/date"},
    "source_deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "date", "sha256"],
      "properties": {
        "filename": {"$ref": "#/$defs/text"},
        "date": {"$ref": "#/$defs/date"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}},
    "separable_extension": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/extension"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "nullable_text": {"type": ["string", "null"], "minLength": 1},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source_slide": {"type": "integer", "enum": [8, 9]},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_kind", "field"],
      "properties": {
        "record_kind": {"type": "string", "enum": ["application", "kernel", "implementation", "input", "machine", "profile", "strategy", "intrinsic", "source_snapshot", "profile_package", "proposal", "candidate", "evaluation", "evaluation_pair", "operation", "hardware_target", "workload", "protocol", "comparison_result", "region_profile", "retention", "team_claim", "certification", "review", "campaign_summary", "workload_characterization", "target_description", "estimate", "cpu_calibration", "cpu_service_calibration", "cpu_memory_resource_calibration", "cpu_bulk_resource_calibration", "cpu_allocator_resource_calibration", "cpu_native_validation", "cpu_error_band", "paired_estimate", "agreement_policy", "agreement_report"]},
        "field": {"$ref": "#/$defs/nullable_text"}
      }
    },
    "targets": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/target"}},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_label", "table_identifier", "field_label", "field_identifier", "disposition", "research", "status", "source_slide", "note"],
      "properties": {
        "table_label": {"$ref": "#/$defs/text"},
        "table_identifier": {"$ref": "#/$defs/nullable_text"},
        "field_label": {"$ref": "#/$defs/nullable_text"},
        "field_identifier": {"$ref": "#/$defs/nullable_text"},
        "disposition": {"enum": ["proposed", "no_counterpart"]},
        "research": {"$ref": "#/$defs/targets"},
        "status": {"const": "unverified"},
        "source_slide": {"$ref": "#/$defs/source_slide"},
        "note": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "proposed"}}},
          "then": {"properties": {"research": {"minItems": 1}}},
          "else": {"properties": {"research": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"field_label": {"type": "null"}}},
          "then": {"properties": {"field_identifier": {"type": "null"}}}
        }
      ]
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept", "research", "status", "source_slide", "note"],
      "properties": {
        "concept": {"$ref": "#/$defs/text"},
        "research": {"allOf": [{"$ref": "#/$defs/targets"}, {"minItems": 1}]},
        "status": {"const": "unverified"},
        "source_slide": {"$ref": "#/$defs/source_slide"},
        "note": {"$ref": "#/$defs/text"}
      }
    }
  }
}
