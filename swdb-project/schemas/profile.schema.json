{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile",
  "title": "Profile: measurements of one implementation on one input and machine, from one swdb profile run",
  "description": "Written by swdb profile, never typed by hand. Raw tool output stays outside git in runs_folder.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "profile"
    },
    "implementation": {
      "type": "string",
      "x-ref": "implementation"
    },
    "input": {
      "type": "string",
      "x-ref": "input"
    },
    "machine": {
      "type": "string",
      "x-ref": "machine"
    },
    "complete": {
      "type": "boolean"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "compiler_version": {
          "type": "string",
          "minLength": 1
        },
        "flags": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "application_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "swdb_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "swdb_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "compiler",
        "compiler_version",
        "flags",
        "command",
        "application_commit",
        "swdb_commit",
        "swdb_dirty"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "type": "string",
          "minLength": 1
        },
        "omp_places": {
          "type": [
            "string",
            "null"
          ]
        },
        "omp_proc_bind": {
          "type": [
            "string",
            "null"
          ]
        },
        "numactl_show": {
          "type": [
            "string",
            "null"
          ]
        },
        "lane": {
          "type": [
            "string",
            "null"
          ]
        },
        "load_1min": {
          "type": [
            "number",
            "null"
          ]
        },
        "users": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "governor": {
          "type": [
            "string",
            "null"
          ]
        },
        "no_turbo": {
          "type": [
            "string",
            "null"
          ]
        },
        "started": {
          "type": "string",
          "minLength": 1
        },
        "finished": {
          "type": [
            "string",
            "null"
          ]
        },
        "dispatch_preflight": {
          "type": "object"
        }
      },
      "required": [
        "host",
        "binding",
        "started"
      ]
    },
    "runs_folder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "host",
        "path"
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "part": {
            "type": "string",
            "x-vocab": "run_parts"
          },
          "outcome": {
            "type": "string",
            "x-vocab": "run_outcomes"
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "started": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished": {
            "type": [
              "string",
              "null"
            ]
          },
          "timeout_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "raw_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "part",
          "outcome"
        ]
      }
    },
    "timing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "threads": {
            "type": "integer",
            "minimum": 1
          },
          "trials": {
            "type": "integer",
            "minimum": 1
          },
          "times_s": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "median_s": {
            "type": "number"
          },
          "min_s": {
            "type": "number"
          },
          "max_s": {
            "type": "number"
          },
          "spread": {
            "type": "number"
          },
          "command": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "threads",
          "trials",
          "times_s",
          "median_s",
          "min_s",
          "max_s",
          "spread",
          "command"
        ]
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/count"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit",
          "basis"
        ],
        "x-required-reasons": {
          "unit": "every metric needs a unit",
          "basis": "every metric states its basis"
        },
        "properties": {
          "name": {
            "type": "string",
            "x-vocab": "metrics"
          },
          "value": {
            "type": [
              "number",
              "array",
              "object",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "x-vocab": "basis"
          },
          "threads": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "array": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": [
              "string",
              "null"
            ],
            "x-vocab": "count_scopes"
          },
          "tool": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_refs": {
            "$ref": "#/$defs/evidence_refs"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "unknown"
                }
              },
              "required": [
                "basis"
              ]
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null",
                  "x-reason": "basis unknown requires value: null"
                }
              }
            }
          }
        ]
      }
    },
    "bottleneck": {
      "type": "object",
      "additionalProperties": false,
      "description": "The inferred bottleneck. While hardware counters are unavailable its basis is inferred (never measured) and rests_on names the metrics it follows from.",
      "required": [
        "value",
        "basis",
        "memory_limit",
        "rests_on"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "x-vocab": "bottleneck_classes"
        },
        "basis": {
          "type": "string",
          "x-vocab": "basis"
        },
        "memory_limit": {
          "type": [
            "string",
            "null"
          ],
          "x-vocab": "memory_limits"
        },
        "rests_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/basis_rule"
        }
      ]
    }
  },
  "required": [
    "implementation",
    "input",
    "machine",
    "complete",
    "build",
    "environment",
    "runs_folder",
    "parts",
    "timing",
    "counts",
    "metrics",
    "bottleneck"
  ]
}
