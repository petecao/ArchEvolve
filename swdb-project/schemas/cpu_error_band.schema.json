{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpu_error_band",
  "description": "Created: 2026-10-06 ET. Updated: 2026-10-09 23:10 ET (code review: v2 adds forecast-only large_errors). Immutable empirical development error or explicit failure; no unvalidated confidence.",
  "properties": {
    "kind": {
      "const": "cpu_error_band"
    },
    "schema_version": {
      "const": "0.4"
    },
    "format": {
      "enum": [
        "swdb.cpu-error-band.v1",
        "swdb.cpu-error-band.v2"
      ]
    },
    "large_errors": {
      "type": "array",
      "description": "v2 only: each known error above admission.large_error_threshold_log with its largest predicted regions; forecast-only, never an observed per-region error.",
      "items": {
        "type": "object",
        "required": [
          "estimate",
          "input",
          "log_error",
          "rounding_aware_absolute_log_error",
          "direction",
          "dominant_regions",
          "attribution"
        ],
        "properties": {
          "direction": {
            "enum": [
              "over_prediction",
              "under_prediction"
            ]
          },
          "dominant_regions": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": [
                "region",
                "seconds",
                "limiting_bound",
                "share_of_predicted_seconds"
              ]
            }
          }
        }
      }
    },
    "backend": {
      "const": "native"
    },
    "evidence_kind": {
      "enum": [
        "fixture",
        "native"
      ]
    },
    "state": {
      "enum": [
        "failed",
        "development",
        "validated",
        "fixture"
      ]
    },
    "width_log": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "frozen_ns": {
      "type": "integer",
      "minimum": 1
    },
    "threads": {
      "type": "integer",
      "minimum": 1
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "development_band": {
      "type": [
        "string",
        "null"
      ]
    },
    "admission": {
      "type": "object"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_description_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "estimator_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "format",
    "backend",
    "evidence_kind",
    "state",
    "width_log",
    "frozen_ns",
    "threads",
    "pairs",
    "development_band",
    "admission",
    "notes",
    "identity_sha256",
    "target_description_sha256",
    "estimator_sha256"
  ]
}
