{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpu_error_band",
  "description": "Created: 2026-10-06 ET. Immutable empirical development error or explicit failure; no unvalidated confidence.",
  "properties": {
    "kind": {
      "const": "cpu_error_band"
    },
    "schema_version": {
      "const": "0.4"
    },
    "format": {
      "const": "swdb.cpu-error-band.v1"
    },
    "backend": {
      "const": "native"
    },
    "evidence_kind": {
      "enum": [
        "fixture",
        "native"
      ]
    },
    "state": {
      "enum": [
        "failed",
        "development",
        "fixture"
      ]
    },
    "width_log": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "frozen_ns": {
      "type": "integer",
      "minimum": 1
    },
    "threads": {
      "type": "integer",
      "minimum": 1
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "development_band": {
      "type": [
        "string",
        "null"
      ]
    },
    "admission": {
      "type": "object"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_description_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "estimator_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "format",
    "backend",
    "evidence_kind",
    "state",
    "width_log",
    "frozen_ns",
    "threads",
    "pairs",
    "development_band",
    "admission",
    "notes",
    "identity_sha256",
    "target_description_sha256",
    "estimator_sha256"
  ]
}
