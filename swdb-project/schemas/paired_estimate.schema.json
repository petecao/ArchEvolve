{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paired_estimate",
  "description": "Created 2026-10-06 ET. A frozen Extensa estimate; unknowns and contract fixtures never establish application agreement. Updated 2026-10-09 ET: optional paired_range (D29).",
  "properties": {
    "message_version": {
      "type": "string"
    },
    "estimator_version": {
      "type": "string"
    },
    "estimated_at": {
      "type": "string"
    },
    "identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "estimator_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "const": "paired_estimate"
    },
    "schema_version": {
      "const": "0.4"
    },
    "format": {
      "const": "swdb.extensa-paired-estimate.v1"
    },
    "mode": {
      "const": "extensa"
    },
    "campaign": {
      "$ref": "#/$defs/extensa_campaign_id"
    },
    "basis": {
      "const": "estimated"
    },
    "estimator_variant": {
      "const": "research"
    },
    "producer": {
      "type": "object"
    },
    "timing_context": {
      "type": "object",
      "required": [
        "subject",
        "input",
        "execution"
      ],
      "properties": {
        "subject": {
          "type": "object",
          "required": [
            "id",
            "artifact_sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "artifact_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "input": {
          "type": "object",
          "required": [
            "id",
            "identity_sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "identity_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "execution": {
          "type": "object",
          "properties": {
            "observation_scope": {
              "const": "artifact_before_certification"
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "observation_scope"
                ]
              },
              "then": {
                "$ref": "#/$defs/artifact_execution"
              }
            }
          ]
        },
        "prior_outcome_exposure": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "state": {
      "enum": [
        "unknown",
        "fixture_estimate"
      ]
    },
    "structural_missing": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_kind": {
      "enum": [
        "execution",
        "contract_fixture"
      ]
    },
    "eligible_for_agreement": {
      "const": false
    },
    "paired_range": {
      "description": "Added 2026-10-09 ET (D29, review F6). Optional; hashed into identity_sha256 only when present. beyond_paired_range marks a graph beyond gem5's sizes and is never counted in agreement statistics. The campaign loop never sets it, because its input is the graph that campaign times.",
      "enum": [
        "within_paired_range",
        "beyond_paired_range"
      ]
    }
  },
  "required": [
    "message_version",
    "estimator_version",
    "estimated_at",
    "identity_sha256",
    "estimator_sha256",
    "policy_sha256",
    "context_sha256",
    "kind",
    "schema_version",
    "format",
    "mode",
    "campaign",
    "basis",
    "estimator_variant",
    "producer",
    "timing_context",
    "seconds",
    "state",
    "structural_missing",
    "evidence_kind",
    "eligible_for_agreement"
  ],
  "$defs": {
    "artifact_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_scope",
        "backend",
        "protocol",
        "protocol_identity_sha256",
        "protocol_settings_sha256",
        "protocol_context",
        "selected_input",
        "target",
        "roi",
        "threads",
        "sources",
        "repetitions"
      ],
      "properties": {
        "observation_scope": {
          "const": "artifact_before_certification"
        },
        "backend": {
          "const": "source_metadata_only"
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "protocol_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "protocol_settings_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "protocol_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "roi",
            "threads",
            "repetitions",
            "sources",
            "workloads"
          ],
          "properties": {
            "target": {
              "enum": [
                "native_cpu",
                "dx100_gem5"
              ]
            },
            "roi": {
              "type": "string",
              "minLength": 1
            },
            "threads": {
              "type": "integer",
              "minimum": 1
            },
            "repetitions": {
              "type": "integer",
              "minimum": 1
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "workloads": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "selected_input": {
          "const": {}
        },
        "target": {
          "enum": [
            "native_cpu",
            "dx100_gem5"
          ]
        },
        "roi": {
          "type": "string",
          "minLength": 1
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "timing_context": {
            "properties": {
              "execution": {
                "required": [
                  "observation_scope"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "unknown"
          },
          "seconds": {
            "const": null
          },
          "eligible_for_agreement": {
            "const": false
          }
        }
      }
    }
  ]
}
