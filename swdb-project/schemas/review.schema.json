{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review",
  "type": "object",
  "properties": {
    "kind": {
      "const": "review"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content_sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "x-ref": "certification"
      }
    }
  },
  "required": [
    "target",
    "reviewer",
    "reviewed_at",
    "evidence"
  ]
}
