{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation",
  "title": "Durable native evaluation",
  "description": "Introduced 2026-09-25. Failure evidence is retained independently of successful profiles.",
  "properties": {
    "kind": {
      "const": "evaluation"
    },
    "schema_version": {
      "const": "0.4"
    },
    "message_version": {
      "const": "1.0"
    },
    "producer": {
      "type": "object"
    },
    "request": {},
    "candidate": {
      "$ref": "#/$defs/id",
      "x-ref": "candidate"
    },
    "proposal": {
      "$ref": "#/$defs/id",
      "x-ref": "proposal"
    },
    "source_snapshot": {
      "$ref": "#/$defs/id",
      "x-ref": "source_snapshot"
    },
    "profile_package": {
      "$ref": "#/$defs/id",
      "x-ref": "profile_package"
    },
    "implementation": {
      "$ref": "#/$defs/id",
      "x-ref": "implementation"
    },
    "machine": {
      "$ref": "#/$defs/id",
      "x-ref": "machine"
    },
    "comparison_baseline": {
      "$ref": "#/$defs/id",
      "x-ref": "implementation"
    },
    "context": {
      "type": "object"
    },
    "build": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "submitted",
            "running",
            "complete",
            "failed",
            "timed_out",
            "interrupted",
            "incorrect",
            "missing_observation",
            "incompatible",
            "budget_exhausted"
          ]
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "stage",
        "reason"
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "state": {
            "enum": [
              "running",
              "complete",
              "failed",
              "timed_out",
              "interrupted",
              "incorrect",
              "missing_observation",
              "incompatible",
              "budget_exhausted"
            ]
          },
          "started": {
            "type": "string"
          },
          "finished": {
            "type": "string"
          },
          "host_wall_s": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "stage",
          "state",
          "started"
        ]
      }
    },
    "timing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "integer",
            "minimum": 0
          },
          "source_position": {
            "type": "integer",
            "minimum": 0
          },
          "repetition": {
            "type": "integer",
            "minimum": 0
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "roi": {
            "type": "string"
          },
          "basis": {
            "enum": [
              "measured",
              "simulated"
            ]
          },
          "quantity": {
            "enum": [
              "native_roi_wall_seconds",
              "simulated_roi_seconds"
            ]
          },
          "binary_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "output": {
            "type": "string"
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "verified": {
            "type": "boolean"
          },
          "evidence_kind": {
            "enum": [
              "execution",
              "contract_fixture"
            ]
          }
        },
        "required": [
          "source",
          "source_position",
          "repetition",
          "duration_s",
          "roi",
          "basis",
          "quantity",
          "binary_sha256",
          "output",
          "output_sha256",
          "verified",
          "evidence_kind"
        ]
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "unverified",
            "passed",
            "failed"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "state",
        "checks"
      ]
    },
    "profiling": {
      "type": "object"
    },
    "raw_artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "gain_claim": {
      "const": false
    },
    "evidence_kind": {
      "enum": [
        "execution",
        "contract_fixture"
      ]
    },
    "component_evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evaluation": {
            "$ref": "#/$defs/id",
            "x-ref": "evaluation"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "evaluation",
          "sha256"
        ]
      }
    },
    "paired_estimate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "swdb.cpu-paired-estimate.v1"
        },
        "basis": {
          "const": "estimated"
        },
        "state": {
          "description": "2026-10-09 23:10 ET code review: the never-produced 'known' state is removed (no record used it).",
          "enum": [
            "unavailable",
            "excluded",
            "paired"
          ]
        },
        "seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "estimate": {
          "type": [
            "object",
            "null"
          ]
        },
        "native_timing_decides": {
          "const": true
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_position",
              "repetition",
              "source",
              "estimate",
              "characterization",
              "counted_payload_sha256",
              "protocol",
              "target_description",
              "seconds",
              "kernel_seconds",
              "missing",
              "runtime_admission",
              "error_band",
              "error_band_reason",
              "prediction_quantity",
              "elapsed_interval_uncertainty"
            ],
            "properties": {
              "source_position": {
                "type": "integer",
                "minimum": 0
              },
              "repetition": {
                "type": "integer",
                "minimum": 0
              },
              "source": {
                "type": "integer",
                "minimum": 0
              },
              "estimate": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "sha256"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "characterization": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "sha256"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "protocol": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "sha256"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "target_description": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "sha256"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "counted_payload_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "seconds": {
                "type": "null"
              },
              "kernel_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "missing": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "runtime_admission": {
                "type": "object"
              },
              "error_band": {
                "type": "null"
              },
              "error_band_reason": {
                "type": "string"
              },
              "prediction_quantity": {
                "const": "semantic_kernel_call_seconds"
              },
              "elapsed_interval_uncertainty": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "seconds",
                  "reason"
                ],
                "properties": {
                  "state": {
                    "const": "unknown"
                  },
                  "seconds": {
                    "type": "null"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "kernel_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "error_band": {
          "type": "null"
        },
        "evaluation_scope_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prepared_before_native_timing": {
          "const": true
        },
        "agreement_claim": {
          "const": false
        }
      },
      "required": [
        "format",
        "basis",
        "state",
        "seconds",
        "estimate",
        "native_timing_decides",
        "missing",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "paired"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "slots",
              "kernel_seconds",
              "error_band",
              "evaluation_scope_sha256",
              "prepared_before_native_timing",
              "agreement_claim"
            ],
            "properties": {
              "seconds": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "message_version",
    "producer",
    "request",
    "outcome",
    "stages",
    "timing",
    "correctness",
    "profiling",
    "raw_artifacts",
    "gain_claim",
    "evidence_kind"
  ]
}
