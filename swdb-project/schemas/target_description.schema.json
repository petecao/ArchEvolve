{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "target_description",
  "description": "Updated: 2026-10-06 ET. Mechanism rates describe the frozen target/thread configuration, not per-thread rates.",
  "properties": {
    "kind": {
      "const": "target_description"
    },
    "schema_version": {
      "const": "0.4"
    },
    "format": {
      "const": "swdb.target-description.v1"
    },
    "version": {
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/id"
    },
    "threads": {
      "type": "integer",
      "minimum": 1
    },
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "basis": {
                  "type": "string",
                  "x-vocab": "basis"
                },
                "source": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "basis",
                "source",
                "unit"
              ],
              "allOf": [
                {
                  "$ref": "#/$defs/basis_rule"
                }
              ]
            }
          },
          "accounting": {
            "enum": [
              "resource_bound",
              "additive_overhead"
            ]
          },
          "selector": {
            "type": "object",
            "description": "Model-defined selection; unsupported fields must produce an unknown model result.",
            "properties": {
              "event_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "domain": {
                "enum": [
                  "host",
                  "offload"
                ]
              },
              "semantic_role": {
                "enum": [
                  "caller",
                  "target_memory",
                  "functional_bookkeeping",
                  "service"
                ]
              },
              "worker_scope": {
                "type": "string"
              },
              "calls": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "required": [
          "model",
          "parameters"
        ]
      }
    },
    "dram_address_layout": {
      "type": [
        "object",
        "null"
      ]
    },
    "estimator_variant": {
      "enum": [
        "team",
        "research"
      ]
    },
    "calibration_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "functional_observation": {
      "$ref": "#/$defs/functional_observation"
    },
    "composition_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "swdb.composition-contract.v1"
        },
        "resource_domain_overlap": {
          "enum": [
            "serial",
            "full_overlap",
            null
          ]
        },
        "basis": {
          "enum": [
            "code_reading",
            "reported",
            "inferred",
            "unknown"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "format",
        "resource_domain_overlap",
        "basis",
        "source"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "resource_domain_overlap": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "basis": {
                "const": "unknown"
              }
            }
          },
          "else": {
            "properties": {
              "basis": {
                "enum": [
                  "code_reading",
                  "reported",
                  "inferred"
                ]
              }
            }
          }
        }
      ]
    },
    "parameter_estimation": {
      "$ref": "#/$defs/parameter_estimation"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "format",
    "version",
    "target",
    "threads",
    "mechanisms",
    "dram_address_layout",
    "estimator_variant",
    "calibration_sources"
  ],
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "basis": {
          "type": "string",
          "x-vocab": "basis"
        },
        "source": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "basis",
        "source",
        "unit"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/basis_rule"
        }
      ]
    },
    "functional_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "swdb.functional-observation.v1"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event": {
                "type": "string"
              },
              "intrinsic": {
                "type": "string"
              },
              "hardware_operations": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "aliases": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "symbol": {
                      "type": "string"
                    },
                    "debug_name": {
                      "type": "string"
                    },
                    "source_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "source": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "root": {
                          "enum": [
                            "library",
                            "project",
                            "repository"
                          ]
                        },
                        "path": {
                          "type": "string"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "root",
                        "path",
                        "sha256"
                      ]
                    },
                    "memory_base_argument": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "active_elements_argument": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "role": {
                      "enum": [
                        "command",
                        "backend_alias"
                      ]
                    },
                    "active_elements_signed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "source_sha256",
                    "memory_base_argument",
                    "role"
                  ],
                  "oneOf": [
                    {
                      "required": [
                        "symbol"
                      ],
                      "not": {
                        "required": [
                          "debug_name"
                        ]
                      }
                    },
                    {
                      "required": [
                        "debug_name"
                      ],
                      "not": {
                        "required": [
                          "symbol"
                        ]
                      }
                    }
                  ]
                }
              },
              "target_access_sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/semantic_source"
                }
              },
              "bookkeeping_access_sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/semantic_source"
                }
              },
              "memory_effect": {
                "enum": [
                  "read",
                  "none"
                ]
              },
              "active_elements_policy": {
                "enum": [
                  "operand_argument",
                  "observed_target_reads",
                  "not_applicable"
                ]
              },
              "target_reads_per_active_element": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "event",
              "intrinsic",
              "hardware_operations",
              "aliases",
              "target_access_sources",
              "bookkeeping_access_sources"
            ]
          },
          "maxItems": 64
        },
        "request_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "transaction_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "read_coalescing": {
              "enum": [
                "none",
                "window_unique_lines"
              ]
            }
          },
          "required": [
            "transaction_bytes",
            "read_coalescing"
          ]
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {
              "enum": [
                "isolated_row_aligned_allocations",
                "unknown"
              ]
            },
            "basis": {
              "enum": [
                "inferred",
                "unknown"
              ]
            },
            "physical_placement_known": {
              "const": false
            }
          },
          "required": [
            "policy",
            "basis",
            "physical_placement_known"
          ]
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {
              "const": "logical_fixed_requests_per_command_worker"
            },
            "requests": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "basis": {
              "enum": [
                "inferred",
                "unknown"
              ]
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "policy",
            "requests",
            "basis",
            "source"
          ]
        }
      },
      "required": [
        "format",
        "commands",
        "request_policy",
        "placement",
        "window"
      ]
    },
    "semantic_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256"
      ],
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "debug_name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root": {
              "enum": [
                "library",
                "project",
                "repository"
              ]
            },
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "root",
            "path",
            "sha256"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "symbol"
          ]
        },
        {
          "required": [
            "debug_name"
          ]
        }
      ]
    },
    "logical_dram_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "rank",
        "bank_group",
        "bank",
        "row"
      ],
      "properties": {
        "channel": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lsb",
              "bits"
            ],
            "properties": {
              "lsb": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "bits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              }
            }
          }
        },
        "rank": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lsb",
              "bits"
            ],
            "properties": {
              "lsb": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "bits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              }
            }
          }
        },
        "bank_group": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lsb",
              "bits"
            ],
            "properties": {
              "lsb": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "bits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              }
            }
          }
        },
        "bank": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lsb",
              "bits"
            ],
            "properties": {
              "lsb": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "bits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              }
            }
          }
        },
        "row": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lsb",
              "bits"
            ],
            "properties": {
              "lsb": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "bits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              }
            }
          }
        }
      }
    },
    "parameter_estimation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "swdb.parameter-estimation.v1"
        },
        "base_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "base_snapshot": {
          "$ref": "#"
        },
        "input_sha256s": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "characterization.json": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "profile.json": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "parameters.json": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "characterization.json",
            "profile.json",
            "parameters.json"
          ]
        },
        "input_record_sha256s": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "characterization": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "profile": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "characterization",
            "profile"
          ]
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parameters": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "parameter": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "enum": [
                      "estimated",
                      "unknown"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "parameter",
                  "value",
                  "unit",
                  "basis",
                  "reason"
                ]
              }
            }
          },
          "required": [
            "parameters"
          ]
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "codex",
                "claude",
                "external_fixture"
              ]
            },
            "classification": {
              "enum": [
                "rewrite_provider",
                "contract_fixture"
              ]
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "effort": {
              "type": [
                "string",
                "null"
              ]
            },
            "cli_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "executable_sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "prompt_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "output_schema_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "receipt_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "workspace_manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "audit_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "audit_passed": {
              "const": true
            },
            "guard_enforced": {
              "type": "boolean"
            },
            "guard_passed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "guard_policy_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "guard_result_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "lane_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "login_copy_deleted": {
              "const": true
            }
          },
          "required": [
            "kind",
            "classification",
            "model",
            "effort",
            "cli_version",
            "executable_sha256",
            "prompt_sha256",
            "output_schema_sha256",
            "receipt_sha256",
            "workspace_manifest_sha256",
            "audit_sha256",
            "audit_passed",
            "guard_enforced",
            "guard_passed",
            "guard_policy_sha256",
            "guard_result_sha256",
            "lane_sha256",
            "login_copy_deleted"
          ]
        },
        "identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {
              "const": "swdb.estimation-projection.v1"
            },
            "policy": {
              "const": "typed_native_counts_and_profile_structure_only"
            },
            "source_sha256s": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "builder": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "contract": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "builder",
                "contract"
              ]
            },
            "files": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "enum": [
                      "characterization.json",
                      "profile.json",
                      "parameters.json"
                    ]
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "name",
                  "bytes",
                  "sha256"
                ]
              }
            },
            "omitted_raw_fields": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "input": {
                    "enum": [
                      "characterization",
                      "profile",
                      "target"
                    ]
                  },
                  "field": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "input",
                  "field",
                  "sha256"
                ]
              }
            }
          },
          "required": [
            "format",
            "policy",
            "source_sha256s",
            "files",
            "omitted_raw_fields"
          ]
        },
        "input_records": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "target_description",
                  "workload_characterization",
                  "profile",
                  "profile_package",
                  "region_profile"
                ]
              },
              "id": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "stored": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "id",
              "sha256",
              "stored"
            ]
          }
        },
        "input_snapshots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "characterization.json": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "format": {
                  "enum": [
                    "swdb.estimation-characterization.v1"
                  ]
                },
                "record_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "input_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "roi_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "source_ir_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "trials": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "position": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "regions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "region_sha256": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            },
                            "operations": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "category": {
                                    "enum": [
                                      "integer",
                                      "floating_point",
                                      "branch",
                                      "atomic"
                                    ]
                                  },
                                  "count": {
                                    "type": [
                                      "integer",
                                      "null"
                                    ],
                                    "minimum": 0
                                  }
                                },
                                "required": [
                                  "category",
                                  "count"
                                ]
                              }
                            },
