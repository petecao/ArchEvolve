{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agreement_policy",
  "description": "Created2026-10-06 ET: immutable research-only prospective D30 evidence.",
  "type": "object",
  "properties": {
    "frozen_at": {
      "type": "string"
    },
    "estimator_sha256": {
      "$ref": "#/$defs/hash"
    },
    "provider_config_sha256": {
      "$ref": "#/$defs/hash"
    },
    "population": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "statistics": {
      "type": "object"
    },
    "D30": {
      "type": "object"
    },
    "structural_missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kind": {
      "const": "agreement_policy"
    },
    "format": {
      "const": "swdb.extensa-agreement-policy.v1"
    },
    "identity_sha256": {
      "$ref": "#/$defs/hash"
    },
    "mode": {
      "const": "extensa"
    },
    "campaign": {
      "$ref": "#/$defs/extensa_campaign_id"
    },
    "basis": {
      "const": "code_reading"
    },
    "estimator_variant": {
      "const": "research"
    },
    "message_version": {
      "type": "string"
    },
    "producer": {
      "type": "object"
    }
  },
  "required": [
    "frozen_at",
    "estimator_sha256",
    "provider_config_sha256",
    "population",
    "statistics",
    "D30",
    "structural_missing",
    "kind",
    "format",
    "identity_sha256",
    "mode",
    "campaign",
    "basis",
    "estimator_variant",
    "message_version",
    "producer"
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
