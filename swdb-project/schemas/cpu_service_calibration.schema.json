{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpu_service_calibration",
  "description": "Created2026-10-06 ET. Independent native service calibration, paired driver elapsed and count/runtime scope; never application validation timing.",
  "properties": {
    "kind": {
      "const": "cpu_service_calibration"
    },
    "schema_version": {
      "const": "0.4"
    },
    "format": {
      "const": "swdb.cpu-service-calibration-record.v1"
    },
    "backend": {
      "const": "native"
    },
    "evidence_kind": {
      "enum": [
        "fixture",
        "native"
      ]
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "$ref": "#/$defs/id"
    },
    "threads": {
      "enum": [
        1,
        2,
        4,
        8,
        16
      ]
    },
    "context": {
      "type": "object"
    },
    "settings": {
      "type": "object"
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "event_definition": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "object"
          },
          "denominator": {
            "type": "object"
          },
          "trials": {
            "type": "array",
            "minItems": 3,
            "maxItems": 11,
            "items": {
              "type": "object",
              "properties": {
                "events": {
                  "type": "integer",
                  "minimum": 1
                },
                "gross_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "driver_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "order": {
                  "enum": [
                    "service_first",
                    "driver_first"
                  ]
                }
              },
              "required": [
                "events",
                "gross_seconds",
                "driver_seconds",
                "order"
              ]
            }
          },
          "parameter": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "basis": {
                "type": "string",
                "x-vocab": "basis"
              },
              "source": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "basis",
              "source",
              "unit"
            ]
          },
          "seconds_per_event": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "unit",
          "event_definition",
          "scope",
          "denominator",
          "trials",
          "parameter",
          "seconds_per_event"
        ]
      }
    }
  },
  "required": [
    "kind",
    "schema_version",
    "format",
    "backend",
    "evidence_kind",
    "receipt_sha256",
    "identity_sha256",
    "target",
    "threads",
    "context",
    "settings",
    "services"
  ]
}
