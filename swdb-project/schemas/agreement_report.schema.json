{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agreement_report",
  "description": "Created: 2026-10-06 ET: immutable research-only prospective D30 evidence. Updated 2026-10-09 23:15 ET (review F2): format v2 applies D30 to numeric pairs; a met rule is reported as d30_met_human_decides, never an automatic switch (story 71).",
  "type": "object",
  "properties": {
    "policy": {
      "type": "string",
      "x-ref": "agreement_policy"
    },
    "policy_sha256": {
      "$ref": "#/$defs/hash"
    },
    "policy_snapshot": {
      "$ref": "#/$defs/policy_snapshot"
    },
    "reported_at": {
      "type": "string"
    },
    "summaries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary_identities": {
      "type": "object"
    },
    "counts": {
      "type": "object"
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "blind_order": {
      "type": "object"
    },
    "rank": {
      "type": "object"
    },
    "top3": {
      "type": "object"
    },
    "gate": {
      "type": "object"
    },
    "recommendation": {
      "enum": [
        "do_not_switch_to_flow_b",
        "d30_met_human_decides"
      ]
    },
    "selection_policy": {
      "const": "unchanged_timing_only"
    },
    "kind": {
      "const": "agreement_report"
    },
    "format": {
      "enum": [
        "swdb.extensa-agreement-report.v1",
        "swdb.extensa-agreement-report.v2"
      ]
    },
    "identity_sha256": {
      "$ref": "#/$defs/hash"
    },
    "mode": {
      "const": "extensa"
    },
    "campaign": {
      "$ref": "#/$defs/extensa_campaign_id"
    },
    "basis": {
      "const": "simulated"
    },
    "estimator_variant": {
      "const": "research"
    },
    "message_version": {
      "type": "string"
    },
    "producer": {
      "type": "object"
    },
    "evidence_kind": {
      "enum": [
        "execution",
        "contract_fixture",
        "mixed_sources",
        "unavailable"
      ]
    }
  },
  "required": [
    "policy",
    "policy_sha256",
    "policy_snapshot",
    "reported_at",
    "summaries",
    "summary_identities",
    "counts",
    "pairs",
    "blind_order",
    "rank",
    "top3",
    "gate",
    "recommendation",
    "selection_policy",
    "kind",
    "format",
    "identity_sha256",
    "mode",
    "campaign",
    "basis",
    "estimator_variant",
    "message_version",
    "producer",
    "evidence_kind"
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frozen_workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "id",
        "identity_sha256",
        "record_sha256",
        "canonical_sha256",
        "sources",
        "generation"
      ],
      "properties": {
        "class": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "x-ref": "workload"
        },
        "identity_sha256": {
          "$ref": "#/$defs/hash"
        },
        "record_sha256": {
          "$ref": "#/$defs/hash"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/hash"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family",
            "generator"
          ],
          "properties": {
            "family": {
              "type": "string"
            },
            "generator": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        }
      }
    },
    "population_member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign",
        "campaign_file_sha256",
        "configuration",
        "workloads",
        "baselines"
      ],
      "properties": {
        "campaign": {
          "$ref": "#/$defs/extensa_campaign_id"
        },
        "campaign_file_sha256": {
          "$ref": "#/$defs/hash"
        },
        "configuration": {
          "type": "object"
        },
        "workloads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frozen_workload"
          }
        },
        "baselines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frozen_baseline"
          }
        }
      }
    },
    "policy_snapshot": {
      "type": "object",
      "properties": {
        "frozen_at": {
          "type": "string"
        },
        "estimator_sha256": {
          "$ref": "#/$defs/hash"
        },
        "provider_config_sha256": {
          "$ref": "#/$defs/hash"
        },
        "population": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/population_member"
          }
        },
        "statistics": {
          "type": "object"
        },
        "D30": {
          "type": "object"
        },
        "structural_missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "const": "agreement_policy"
        },
        "format": {
          "const": "swdb.extensa-agreement-policy.v1"
        },
        "identity_sha256": {
          "$ref": "#/$defs/hash"
        },
        "mode": {
          "const": "extensa"
        },
        "campaign": {
          "$ref": "#/$defs/extensa_campaign_id"
        },
        "basis": {
          "const": "code_reading"
        },
        "estimator_variant": {
          "const": "research"
        },
        "message_version": {
          "type": "string"
        },
        "producer": {
          "type": "object"
        }
      },
      "required": [
        "frozen_at",
        "estimator_sha256",
        "provider_config_sha256",
        "population",
        "statistics",
        "D30",
        "structural_missing",
        "kind",
        "format",
        "identity_sha256",
        "mode",
        "campaign",
        "basis",
        "estimator_variant",
        "message_version",
        "producer",
        "id"
      ]
    },
    "frozen_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "candidate",
        "record_sha256",
        "artifact_sha256"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "candidate": {
          "type": "string",
          "x-ref": "candidate"
        },
        "record_sha256": {
          "$ref": "#/$defs/hash"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}
