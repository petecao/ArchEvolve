{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "certification",
  "type": "object",
  "properties": {
    "kind": {
      "const": "certification"
    },
    "message_version": {
      "type": "string"
    },
    "producer": {
      "type": "object"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content_sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "content_sha256"],
        "properties": {
          "id": {"type": "string"},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "candidate": {
      "type": [
        "object",
        "null"
      ]
    },
    "command": {
      "type": "object"
    },
    "host": {
      "type": "object"
    },
    "matrix": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "negative_controls": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "verdict": {
      "enum": [
        "certified",
        "failed",
        "inconclusive"
      ]
    },
    "evidence_basis": {
      "const": "simulated"
    },
    "created_at": {
      "type": "string"
    },
    "raw_artifacts": {
      "type": "array"
    },
    "outcome": {
      "type": "object"
    },
    "clause_controls": {
      "description": "2026-10-04 ET: per contract clause, its negative control compared with the check the clause names.",
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["clause", "control", "check", "matched", "enforceable"],
        "properties": {
          "clause": {"type": "string"},
          "control": {"type": "string"},
          "check": {"type": "string"},
          "source": {"enum": ["contract", "plugin", "certifier"], "description": "2026-10-04 ET (ticket 68): certifier rows enforce knob_range and schedule_range through the certifier's own controls."},
          "reason": {"enum": ["no_run_reports_check", "control_cannot_exercise_check"], "description": "Why a row is not enforceable (ticket 68)."},
          "observed_checks": {"type": "array", "items": {"type": "string"}},
          "matched": {"type": "boolean"},
          "enforceable": {"type": "boolean"}
        }
      }
    },
    "profile": {
      "description": "2026-10-05 ET (ticket 75): the native candidate profile a native-CPU contract pins (id, path, sha256, target, target_scope; under certify 1.4 also the random run schedule), for command versions 1.3 and 1.4.",
      "type": "object",
      "required": ["id", "path", "sha256", "target"],
      "properties": {
        "id": {"type": "string"},
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target": {"const": "native_cpu"},
        "target_scope": {"type": "string"},
        "schedule": {"type": "array", "items": {"type": "object"}}
      }
    },
    "evidence_kind": {
      "enum": [
        "execution",
        "contract_fixture"
      ]
    }
  },
  "required": [
    "entry",
    "command",
    "host",
    "matrix",
    "negative_controls",
    "verdict",
    "evidence_basis"
  ]
}
