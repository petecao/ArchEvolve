{
  "definitions": [
    {
      "begin": 7104,
      "container_sha256": "a8f89e41decdbd2890f72e7725590c62134650fde84a18a6ec7fd9d5bd9abbc5",
      "end": 7335,
      "relative": "swdb/heap_reallocation.mlw",
      "sha256": "ccab9af0570f7363c265230cebdac38a9e33f3a01f56ff5204af1c6031cff371",
      "text": "  predicate copied_prefix (entry now:heap) (source source_offset target count:int) =\n    forall j:int. 0 <= j < count ->\n      int32_at now target (4*j) /\\\n      load_int now target (4*j) = load_int entry source (source_offset+4*j)"
    },
    {
      "begin": 5623,
      "container_sha256": "a8f89e41decdbd2890f72e7725590c62134650fde84a18a6ec7fd9d5bd9abbc5",
      "end": 5806,
      "relative": "swdb/heap_reallocation.mlw",
      "sha256": "b659f9be16c81c149591d83d852b03a1c411b0b4444a7818822e36ae9bc69301",
      "text": "  predicate int32_at (h:heap) (b o:int) =\n    typed_reads h b o 4 4 /\\ initialized_at h b o /\\\n    integer_at h b o (load_int h b o) /\\\n    -2147483648 <= load_int h b o <= 2147483647"
    },
    {
      "begin": 6945,
      "container_sha256": "a8f89e41decdbd2890f72e7725590c62134650fde84a18a6ec7fd9d5bd9abbc5",
      "end": 7103,
      "relative": "swdb/heap_reallocation.mlw",
      "sha256": "f36185721459640491e6e417609fc1714621223369e5817814b1a8942732106c",
      "text": "  function copy_int (h:heap) (source source_offset target target_offset:int) : heap =\n    put_integer h target target_offset (load_int h source source_offset)"
    },
    {
      "begin": 4451,
      "container_sha256": "a8f89e41decdbd2890f72e7725590c62134650fde84a18a6ec7fd9d5bd9abbc5",
      "end": 4645,
      "relative": "swdb/heap_reallocation.mlw",
      "sha256": "1dbf1371e9074def8ea5998150636e778755c3a83d9f816b92a1706b0afaecab",
      "text": "  function put_integer (h:heap) (b o v:int) : heap =\n    { h with memory = set h.memory b (set h.memory[b] o (Integer v));\n      initialized = set h.initialized b (set h.initialized[b] o True) }"
    }
  ],
