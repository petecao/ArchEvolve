// SWDB changes: reference TU calls SWDB's plain C++ reference header (swdb_ref::) instead of DataLayoutAPI; run TU drops all timing and adds an input frame check (2026-10-03 ET); the chain depth is a runtime argument (1 or 2)
// Two-binary certification CANDIDATE TU for family pack: includes a cleanroom
// copy of the candidate header (a synthesized `SynthBackend`); its macros and
// includes stay in this TU.
#include "{{BACKEND_HEADER}}"
#include <cstddef>
#include <cstdint>
extern "C" void swdb_cand_pack(double* packed, const double* src, const std::int32_t* chain0, const std::int32_t* chain1, std::size_t depth, std::size_t n, std::int64_t coeff, std::int64_t offset, std::size_t n_src) {
  const std::int32_t* chain[2] = {chain0, chain1};
  SynthBackend::pack_gather<double, std::int32_t>(packed, src, chain, depth, n, coeff, offset, n_src);
}
