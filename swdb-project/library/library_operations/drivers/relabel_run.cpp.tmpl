// SWDB changes: SWDB addition (ticket 51): the gather templates adapted to vertex relabeling (out[perm[v]] = in[v]); no timing; input frame check (2026-10-03 ET)
// Two-binary certification RUN TU for family relabel. It links EXACTLY ONE of the
// reference or candidate extern symbols ({{RUN_SYMBOL}}), so no candidate object
// code ever shares a link step with the reference. The output is seeded with a
// nonzero canary before the call (an accumulate-instead-of-assign candidate then
// diverges), the inputs are compared with their pre-call copies afterwards (a
// write into an input is a named frame violation), and nothing is timed: SWDB's
// evaluator supplies every performance number.
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <string>
#include <vector>

extern "C" void {{RUN_SYMBOL}}(double*, const double*, const std::int32_t*, std::size_t);

template <typename T>
static std::vector<T> slurp_as(const std::string& p) {
  FILE* f = std::fopen(p.c_str(), "rb");
  if (!f) { std::fprintf(stderr, "cannot open %s\n", p.c_str()); std::exit(2); }
  std::fseek(f, 0, SEEK_END); long sz = std::ftell(f); std::fseek(f, 0, SEEK_SET);
  std::vector<T> buf((std::size_t)sz / sizeof(T));
  if (sz > 0 && std::fread(&buf[0], 1, (std::size_t)sz, f) != (std::size_t)sz) std::exit(2);
  std::fclose(f); return buf;
}
static void dump(const std::string& p, const void* d, std::size_t bytes) {
  FILE* f = std::fopen(p.c_str(), "wb");
  if (!f) std::exit(2);
  std::fwrite(d, 1, bytes, f); std::fclose(f);
}

int main(int argc, char** argv) {
  if (argc != 3) { std::fprintf(stderr, "usage: n case_dir\n"); return 2; }
  const std::size_t n = std::strtoull(argv[1], nullptr, 10);
  const std::string dir = argv[2];
  std::vector<double> values = slurp_as<double>(dir + "/values.bin");
  std::vector<std::int32_t> perm = slurp_as<std::int32_t>(dir + "/perm.bin");
  const std::vector<double> v0 = values; const std::vector<std::int32_t> p0 = perm;
  std::vector<double> out(n);
  for (std::size_t i = 0; i < out.size(); ++i) out[i] = 1.0 + (double)(i % 7);  // canary
  {{RUN_SYMBOL}}(out.data(), values.data(), perm.data(), n);
  if (values != v0 || perm != p0) {
    std::fprintf(stderr, "SWDB_PRESERVATION_FAIL:frame_violation\n");
    return 3;
  }
  dump(dir + "/{{OUT_FILE}}", out.data(), (n) * sizeof(double));
  std::printf("SWDB_RUN_DONE:{{NS_LABEL}}\n");
  return 0;
}
