conflicts =
fun (loc val arg : Type) (d e : event loc val arg) =>
match d return Prop with
| Read _ _ _ _ _ => False
| Write _ _ _ _ _ => False
| HistoryRead _ _ _ _ _ => False
| Shared _ _ _ _ _ _ _ _ => False
| DeviceRead _ _ _ _ l _ =>
    match e return Prop with
    | Read _ _ _ _ _ => False
    | Write _ _ _ l' _ => @eq loc l l'
    | HistoryRead _ _ _ _ _ => False
    | Shared _ _ _ _ _ _ l' _ => @eq loc l l'
    | DeviceRead _ _ _ _ _ _ => False
    | DeviceWrite _ _ _ _ _ _ => False
    | DeviceCovered _ _ _ _ => False
    | Own _ _ _ _ => False
    | Enter _ _ _ => False
    | Exit _ _ _ => False
    | Workshare _ _ _ _ => False
    | Iter _ _ _ _ _ => False
    | Barrier _ _ _ => False
    end
| DeviceWrite _ _ _ _ l _ =>
    match e return Prop with
    | Read _ _ _ l' _ => @eq loc l l'
    | Write _ _ _ l' _ => @eq loc l l'
    | HistoryRead _ _ _ l' _ => @eq loc l l'
    | Shared _ _ _ _ _ _ l' _ => @eq loc l l'
    | DeviceRead _ _ _ _ _ _ => False
    | DeviceWrite _ _ _ _ _ _ => False
    | DeviceCovered _ _ _ _ => False
    | Own _ _ _ _ => False
    | Enter _ _ _ => False
    | Exit _ _ _ => False
    | Workshare _ _ _ _ => False
    | Iter _ _ _ _ _ => False
    | Barrier _ _ _ => False
    end
| DeviceCovered _ _ _ _ => False
| Own _ _ _ _ => False
| Enter _ _ _ => False
| Exit _ _ _ => False
| Workshare _ _ _ _ => False
| Iter _ _ _ _ _ => False
| Barrier _ _ _ => False
end
     : forall (loc val arg : Type) (_ : event loc val arg)
         (_ : event loc val arg),
       Prop

Arguments conflicts (loc val arg)%_type_scope d e
covered_between =
fun (loc val arg : Type) (tr : list (event loc val arg)) (c p q : nat) =>
@ex nat
  (fun m : nat =>
   and (and (lt p m) (lt m q))
     (@eq (option (event loc val arg))
        (@List.nth_error (event loc val arg) tr m)
        (@Some (event loc val arg) (DeviceCovered loc val arg c))))
     : forall (loc val arg : Type) (_ : list (event loc val arg)) 
         (_ : nat) (_ : nat) (_ : nat),
       Prop

Arguments covered_between (loc val arg)%_type_scope 
  tr%_list_scope (c p q)%_nat_scope
crosses_sync =
fun (loc val arg : Type) (tr : list (event loc val arg)) (c : nat) =>
@ex nat
  (fun p : nat =>
   @ex nat
     (fun q : nat =>
      @ex (event loc val arg)
        (fun d : event loc val arg =>
         @ex (event loc val arg)
           (fun e : event loc val arg =>
            and
              (@eq (option (event loc val arg))
                 (@List.nth_error (event loc val arg) tr p)
                 (@Some (event loc val arg) d))
              (and
                 (@eq (option nat) (device_cmd loc val arg d) (@Some nat c))
                 (and (lt p q)
                    (and
                       (@eq (option (event loc val arg))
                          (@List.nth_error (event loc val arg) tr q)
                          (@Some (event loc val arg) e))
                       (and
                          (or
                             (@eq (event loc val arg) e (Barrier loc val arg))
                             (and
                                (@eq (event loc val arg) e (Exit loc val arg))
                                (@eq bool
                                   (in_crit loc val arg
                                      (@ListDef.firstn 
                                         (event loc val arg) p tr)
                                      false)
                                   true)))
                          (not (covered_between loc val arg tr c p q))))))))))
     : forall (loc val arg : Type) (_ : list (event loc val arg)) (_ : nat),
       Prop

Arguments crosses_sync (loc val arg)%_type_scope tr%_list_scope c%_nat_scope
reads_loc =
fun (loc val arg : Type) (e : event loc val arg) (l : loc) =>
match read_value loc val arg e return Prop with
| @Some _ p => match p return Prop with
               | @pair _ _ l' _ => @eq loc l' l
               end
| @None _ => False
end
     : forall (loc val arg : Type) (_ : event loc val arg) (_ : loc), Prop

Arguments reads_loc (loc val arg)%_type_scope e l
dead_after =
fun (loc val arg : Type) (is_tile : forall _ : loc, Prop)
  (tr : list (event loc val arg)) (c : nat) =>
and
  (@ex nat
     (fun p : nat =>
      @ex loc
        (fun l : loc =>
         @ex val
           (fun v : val =>
            @eq (option (event loc val arg))
              (@List.nth_error (event loc val arg) tr p)
              (@Some (event loc val arg) (DeviceWrite loc val arg c l v))))))
  (forall (p : nat) (l : loc) (v : val)
     (_ : @eq (option (event loc val arg))
            (@List.nth_error (event loc val arg) tr p)
            (@Some (event loc val arg) (DeviceWrite loc val arg c l v))),
   and (is_tile l)
     (forall (r : nat) (e : event loc val arg) (_ : lt p r)
        (_ : @eq (option (event loc val arg))
               (@List.nth_error (event loc val arg) tr r)
               (@Some (event loc val arg) e))
        (_ : reads_loc loc val arg e l),
      @ex nat
        (fun w : nat =>
         @ex nat
           (fun c' : nat =>
            @ex val
              (fun v' : val =>
               and (and (lt p w) (lt w r))
                 (and
                    (@eq (option (event loc val arg))
                       (@List.nth_error (event loc val arg) tr w)
                       (@Some (event loc val arg)
                          (DeviceWrite loc val arg c' l v')))
                    (not (@eq nat c' c))))))))
     : forall (loc val arg : Type) (_ : forall _ : loc, Prop)
         (_ : list (event loc val arg)) (_ : nat),
       Prop

Arguments dead_after (loc val arg)%_type_scope is_tile%_function_scope
  tr%_list_scope c%_nat_scope
quiet_ok =
fun (loc val arg : Type) (is_tile : forall _ : loc, Prop)
  (tr : list (event loc val arg)) =>
and
  (forall (p : nat) (d : event loc val arg) (c : nat)
     (_ : @eq (option (event loc val arg))
            (@List.nth_error (event loc val arg) tr p)
            (@Some (event loc val arg) d))
     (_ : @eq (option nat) (device_cmd loc val arg d) (@Some nat c))
     (m : nat) (e : event loc val arg) (_ : lt p m)
     (_ : @eq (option (event loc val arg))
            (@List.nth_error (event loc val arg) tr m)
            (@Some (event loc val arg) e))
     (_ : conflicts loc val arg d e),
   covered_between loc val arg tr c p m)
  (forall (c : nat) (_ : crosses_sync loc val arg tr c),
   dead_after loc val arg is_tile tr c)
     : forall (loc val arg : Type) (_ : forall _ : loc, Prop)
         (_ : list (event loc val arg)),
       Prop

Arguments quiet_ok (loc val arg)%_type_scope is_tile%_function_scope
  tr%_list_scope
obl_dx100_quiet =
fun (loc arr val arg : Type) (array_of : forall _ : loc, arr)
  (is_tile : forall _ : loc, Prop) (init : forall _ : loc, val)
  (sa_new : forall (_ : shared_action_kind) (_ : arg) (_ : val), option val)
  (N team_size : nat) (cls : forall (_ : nat) (_ : arr), sharing_class)
  (space : forall _ : nat, list nat) (split_by_tid : forall _ : nat, bool)
  (step : forall (_ : nat) (_ : list (event loc val arg))
            (_ : event loc val arg),
          Prop)
  (done : forall (_ : nat) (_ : list (event loc val arg)), Prop) =>
forall (X : run loc val arg) (rf : rf_map) (t : nat)
  (_ : model_run loc val arg init sa_new team_size space split_by_tid step
         done X rf)
  (_ : complete loc val arg N done X)
  (_ : all_fit loc arr val arg array_of N cls X) (_ : lt t N),
quiet_ok loc val arg is_tile (proj loc val arg X t)
     : forall (loc arr val arg : Type) (_ : forall _ : loc, arr)
         (_ : forall _ : loc, Prop) (_ : forall _ : loc, val)
         (_ : forall (_ : shared_action_kind) (_ : arg) (_ : val), option val)
         (_ : nat) (_ : nat) (_ : forall (_ : nat) (_ : arr), sharing_class)
         (_ : forall _ : nat, list nat) (_ : forall _ : nat, bool)
         (_ : forall (_ : nat) (_ : list (event loc val arg))
                (_ : event loc val arg),
              Prop)
         (_ : forall (_ : nat) (_ : list (event loc val arg)), Prop),
       Prop

Arguments obl_dx100_quiet (loc arr val arg)%_type_scope
  (array_of is_tile init sa_new)%_function_scope (N team_size)%_nat_scope
  (cls space split_by_tid step done)%_function_scope
intervals_contiguous =
fun (loc val arg : Type) (Y : run loc val arg) =>
forall (i j t t' : nat) (e e' : event loc val arg) 
  (_ : lt i j) (_ : at_ loc val arg Y i t e) (_ : at_ loc val arg Y j t' e'),
le (interval loc val arg Y t i) (interval loc val arg Y t' j)
     : forall (loc val arg : Type) (_ : run loc val arg), Prop

Arguments intervals_contiguous (loc val arg)%_type_scope Y
critical_sections_contiguous =
fun (loc val arg : Type) (Y : run loc val arg) =>
forall (i x t : nat) (_ : at_ loc val arg Y i t (Enter loc val arg))
  (_ : at_ loc val arg Y x t (Exit loc val arg)) (_ : lt i x)
  (_ : forall (m : nat) (_ : and (lt i m) (lt m x)),
       and (not (at_ loc val arg Y m t (Enter loc val arg)))
         (not (at_ loc val arg Y m t (Exit loc val arg))))
  (m : nat) (_ : and (lt i m) (lt m x)),
@ex (event loc val arg)
  (fun e : event loc val arg => at_ loc val arg Y m t e)
     : forall (loc val arg : Type) (_ : run loc val arg), Prop

Arguments critical_sections_contiguous (loc val arg)%_type_scope Y
reads_latest =
fun (loc arr val arg : Type) (array_of : forall _ : loc, arr)
  (init : forall _ : loc, val)
  (sa_new : forall (_ : shared_action_kind) (_ : arg) (_ : val), option val)
  (cls : forall (_ : nat) (_ : arr), sharing_class) 
  (Y : run loc val arg) (rf : rf_map) =>
forall (j t : nat) (e : event loc val arg) (l : loc) 
  (v : val) (_ : at_ loc val arg Y j t e)
  (_ : @eq (option (prod loc val)) (read_value loc val arg e)
         (@Some (prod loc val) (@pair loc val l v)))
  (_ : or (@eq bool (is_shared loc val arg e) true)
         (and
            (not
               (@eq sharing_class
                  (cls (interval loc val arg Y t j) (array_of l))
                  SharedActionsOnly))
            (not
               (@ex nat
                  (fun c : nat =>
                   and
                     (@eq (option nat) (device_cmd loc val arg e)
                        (@Some nat c))
                     (crosses_sync loc val arg (proj loc val arg Y t) c)))))),
and (source_ok loc val arg init sa_new Y l v (rf j) j)
  (latest loc val arg sa_new Y l j (rf j))
     : forall (loc arr val arg : Type) (_ : forall _ : loc, arr)
         (_ : forall _ : loc, val)
         (_ : forall (_ : shared_action_kind) (_ : arg) (_ : val), option val)
         (_ : forall (_ : nat) (_ : arr), sharing_class)
         (_ : run loc val arg) (_ : rf_map),
       Prop

Arguments reads_latest (loc arr val arg)%_type_scope
  (array_of init sa_new cls)%_function_scope Y rf
final_is =
fun (loc val arg : Type) (init : forall _ : loc, val)
  (sa_new : forall (_ : shared_action_kind) (_ : arg) (_ : val), option val)
  (X : run loc val arg) (l : loc) (v : val) =>
or
  (@ex nat
     (fun i : nat =>
      and (writes loc val arg sa_new X i l v)
        (forall (i' : nat) (v' : val) (_ : lt i i'),
         not (writes loc val arg sa_new X i' l v'))))
  (and (@eq val v (init l))
     (forall (i : nat) (v' : val), not (writes loc val arg sa_new X i l v')))
     : forall (loc val arg : Type) (_ : forall _ : loc, val)
         (_ : forall (_ : shared_action_kind) (_ : arg) (_ : val), option val)
         (_ : run loc val arg) (_ : loc) (_ : val),
       Prop

Arguments final_is (loc val arg)%_type_scope (init sa_new)%_function_scope 
  X l v
iterations_once =
fun (loc val arg : Type) (N : nat) (space : forall _ : nat, list nat)
  (Y : run loc val arg) =>
forall (w : nat)
  (_ : @ex nat
         (fun t : nat =>
          and (lt t N)
            (@List.In (event loc val arg) (Workshare loc val arg w)
               (proj loc val arg Y t))))
  (i : nat),
@eq nat (count_iter loc val arg Y w i)
  match @List.in_dec nat PeanoNat.Nat.eq_dec i (space w) return nat with
  | @left _ _ _ => S O
  | @right _ _ _ => O
  end
     : forall (loc val arg : Type) (_ : nat) (_ : forall _ : nat, list nat)
         (_ : run loc val arg),
       Prop

Arguments iterations_once (loc val arg)%_type_scope 
  N%_nat_scope space%_function_scope Y
serial_outcome =
fun (loc arr val arg : Type) (array_of : forall _ : loc, arr)
  (init : forall _ : loc, val)
  (sa_new : forall (_ : shared_action_kind) (_ : arg) (_ : val), option val)
  (N team_size : nat) (cls : forall (_ : nat) (_ : arr), sharing_class)
  (space : forall _ : nat, list nat) (split_by_tid : forall _ : nat, bool)
  (done : forall (_ : nat) (_ : list (event loc val arg)), Prop)
  (X Y : run loc val arg) (rf' : rf_map) =>
and
  (forall t : nat,
   @eq (list (event loc val arg)) (proj loc val arg Y t)
     (proj loc val arg X t))
  (and (intervals_contiguous loc val arg Y)
     (and (critical_sections_contiguous loc val arg Y)
        (and
           (forall (t : nat) (blk : list (event loc val arg))
              (_ : critical_block loc val arg (proj loc val arg Y t) blk),
            implements_shared_action loc val arg sa_new blk)
           (and (reads_latest loc arr val arg array_of init sa_new cls Y rf')
              (and (memory_ok loc val arg init sa_new Y rf')
                 (and
                    (omp_ok loc val arg sa_new team_size space split_by_tid
                       done Y rf')
                    (and (device_ok loc val arg init sa_new Y rf')
                       (and
                          (forall (l : loc) (v : val),
                           iff (final_is loc val arg init sa_new X l v)
                             (final_is loc val arg init sa_new Y l v))
                          (iterations_once loc val arg N space Y)))))))))
     : forall (loc arr val arg : Type) (_ : forall _ : loc, arr)
         (_ : forall _ : loc, val)
         (_ : forall (_ : shared_action_kind) (_ : arg) (_ : val), option val)
         (_ : nat) (_ : nat) (_ : forall (_ : nat) (_ : arr), sharing_class)
         (_ : forall _ : nat, list nat) (_ : forall _ : nat, bool)
         (_ : forall (_ : nat) (_ : list (event loc val arg)), Prop)
         (_ : run loc val arg) (_ : run loc val arg) 
         (_ : rf_map),
       Prop

Arguments serial_outcome (loc arr val arg)%_type_scope
  (array_of init sa_new)%_function_scope (N team_size)%_nat_scope
  (cls space split_by_tid done)%_function_scope X 
  Y rf'
parallel_composition
     : forall (loc arr val arg : Type) (array_of : forall _ : loc, arr)
         (is_tile : forall _ : loc, Prop) (init : forall _ : loc, val)
         (sa_new : forall (_ : shared_action_kind) (_ : arg) (_ : val),
                   option val)
         (N team_size : nat)
         (cls : forall (_ : nat) (_ : arr), sharing_class)
         (space : forall _ : nat, list nat)
         (split_by_tid : forall _ : nat, bool)
         (chunk : forall (_ : nat) (_ : nat), list nat)
         (step : forall (_ : nat) (_ : list (event loc val arg))
                   (_ : event loc val arg),
                 Prop)
         (done : forall (_ : nat) (_ : list (event loc val arg)), Prop)
         (_ : obl_class_fit loc arr val arg array_of init sa_new N team_size
                cls space split_by_tid step done)
         (_ : obl_owned_disjoint loc arr val arg array_of init sa_new N
                team_size cls space split_by_tid step done)
         (_ : obl_atomic_blocks loc val arg sa_new N step)
         (_ : obl_chunk_cover loc arr val arg array_of init sa_new N
                team_size cls space split_by_tid chunk step done)
         (_ : obl_uniform_control loc arr val arg array_of init sa_new N
                team_size cls space split_by_tid step done)
         (_ : obl_team_size N team_size)
         (_ : obl_dx100_quiet loc arr val arg array_of is_tile init sa_new N
                team_size cls space split_by_tid step done)
         (X : run loc val arg) (rf : rf_map)
         (_ : program_run loc val arg step X)
         (_ : memory_ok loc val arg init sa_new X rf)
         (_ : omp_ok loc val arg sa_new team_size space split_by_tid done X
                rf)
         (_ : device_ok loc val arg init sa_new X rf)
         (_ : complete loc val arg N done X),
       @ex (run loc val arg)
         (fun Y : run loc val arg =>
          @ex rf_map
            (fun rf' : rf_map =>
             serial_outcome loc arr val arg array_of init sa_new N team_size
               cls space split_by_tid done X Y rf'))
