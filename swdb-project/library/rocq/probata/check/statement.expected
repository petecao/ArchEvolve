obl_owned_disjoint =
fun (loc arr val arg : Type) (array_of : forall _ : loc, arr)
  (init : forall _ : loc, val)
  (sa_new : forall (_ : shared_action_kind) (_ : arg) (_ : val), option val)
  (N team_size : nat) (cls : forall (_ : nat) (_ : arr), sharing_class)
  (space : forall _ : nat, list nat) (split_by_tid : forall _ : nat, bool)
  (step : forall (_ : nat) (_ : list (event loc val arg))
            (_ : event loc val arg),
          Prop)
  (done : forall (_ : nat) (_ : list (event loc val arg)), Prop) =>
forall (X : run loc val arg) (rf : rf_map) (t t' i i' : nat) 
  (l : loc)
  (_ : model_run loc val arg init sa_new team_size space split_by_tid step
         done X rf)
  (_ : all_fit loc arr val arg array_of N cls X) (_ : not (@eq nat t t'))
  (_ : at_ loc val arg X i t (Own loc val arg l))
  (_ : at_ loc val arg X i' t' (Own loc val arg l)),
not (@eq nat (interval loc val arg X t i) (interval loc val arg X t' i'))
     : forall (loc arr val arg : Type) (_ : forall _ : loc, arr)
         (_ : forall _ : loc, val)
         (_ : forall (_ : shared_action_kind) (_ : arg) (_ : val), option val)
         (_ : nat) (_ : nat) (_ : forall (_ : nat) (_ : arr), sharing_class)
         (_ : forall _ : nat, list nat) (_ : forall _ : nat, bool)
         (_ : forall (_ : nat) (_ : list (event loc val arg))
                (_ : event loc val arg),
              Prop)
         (_ : forall (_ : nat) (_ : list (event loc val arg)), Prop),
