critical_block =
fun (loc val arg : Type) (tr blk : list (event loc val arg)) =>
@ex (list (event loc val arg))
  (fun pre : list (event loc val arg) =>
   @ex (list (event loc val arg))
     (fun post : list (event loc val arg) =>
      and
        (@eq (list (event loc val arg)) tr
           (@app (event loc val arg) pre
              (@cons (event loc val arg) (Enter loc val arg)
                 (@app (event loc val arg) blk
                    (@cons (event loc val arg) (Exit loc val arg) post)))))
        (and (not (@List.In (event loc val arg) (Enter loc val arg) blk))
           (not (@List.In (event loc val arg) (Exit loc val arg) blk)))))
     : forall (loc val arg : Type) (_ : list (event loc val arg))
         (_ : list (event loc val arg)),
       Prop

Arguments critical_block (loc val arg)%_type_scope (tr blk)%_list_scope
implements_shared_action =
fun (loc val arg : Type)
  (sa_new : forall (_ : shared_action_kind) (_ : arg) (_ : val), option val)
  (blk : list (event loc val arg)) =>
@ex shared_action_kind
  (fun k : shared_action_kind =>
   @ex arg
     (fun a : arg =>
      @ex loc
        (fun l : loc =>
         @ex val
           (fun old : val =>
            and
              (@ex (list (event loc val arg))
                 (fun pre : list (event loc val arg) =>
                  @ex (event loc val arg)
                    (fun e : event loc val arg =>
                     @ex (list (event loc val arg))
                       (fun post : list (event loc val arg) =>
                        and
                          (@eq (list (event loc val arg)) blk
                             (@app (event loc val arg) pre
                                (@cons (event loc val arg) e post)))
                          (and (@eq bool (is_shared loc val arg e) false)
                             (and
                                (@eq (option (prod loc val))
                                   (read_value loc val arg e)
                                   (@Some (prod loc val)
                                      (@pair loc val l old)))
                                (forall (e' : event loc val arg)
                                   (_ : @List.In (event loc val arg) e' pre),
                                 not
                                   (@eq (option loc) 
                                      (loc_of loc val arg e') 
                                      (@Some loc l)))))))))
              match sa_new k a old return Prop with
              | @Some _ w =>
                  and
                    (forall (e : event loc val arg) 
                       (l' : loc) (v : val)
                       (_ : @List.In (event loc val arg) e blk)
                       (_ : @eq (option (prod loc val))
                              (written loc val arg sa_new e)
                              (@Some (prod loc val) (@pair loc val l' v))),
                     @eq loc l' l)
                    (@ex (list (event loc val arg))
                       (fun pre : list (event loc val arg) =>
                        @ex (event loc val arg)
                          (fun e : event loc val arg =>
                           @ex (list (event loc val arg))
                             (fun post : list (event loc val arg) =>
                              and
                                (@eq (list (event loc val arg)) blk
                                   (@app (event loc val arg) pre
                                      (@cons (event loc val arg) e post)))
                                (and
                                   (@eq (option (prod loc val))
                                      (written loc val arg sa_new e)
                                      (@Some (prod loc val)
                                         (@pair loc val l w)))
                                   (forall (e' : event loc val arg)
                                      (_ : @List.In 
                                             (event loc val arg) e' post),
                                    @eq (option (prod loc val))
                                      (written loc val arg sa_new e')
                                      (@None (prod loc val))))))))
              | @None _ =>
                  forall (e : event loc val arg)
                    (_ : @List.In (event loc val arg) e blk),
                  @eq (option (prod loc val)) (written loc val arg sa_new e)
                    (@None (prod loc val))
              end))))
     : forall (loc val arg : Type)
         (_ : forall (_ : shared_action_kind) (_ : arg) (_ : val), option val)
         (_ : list (event loc val arg)),
       Prop

Arguments implements_shared_action (loc val arg)%_type_scope
  sa_new%_function_scope blk%_list_scope
obl_atomic_blocks =
fun (loc val arg : Type)
  (sa_new : forall (_ : shared_action_kind) (_ : arg) (_ : val), option val)
  (N : nat)
  (step : forall (_ : nat) (_ : list (event loc val arg))
            (_ : event loc val arg),
          Prop) =>
forall (t : nat) (tr blk : list (event loc val arg)) 
  (_ : lt t N) (_ : program_trace loc val arg step t tr)
  (_ : critical_block loc val arg tr blk),
and (implements_shared_action loc val arg sa_new blk)
  (not (@List.In (event loc val arg) (Barrier loc val arg) blk))
     : forall (loc val arg : Type)
         (_ : forall (_ : shared_action_kind) (_ : arg) (_ : val), option val)
         (_ : nat)
         (_ : forall (_ : nat) (_ : list (event loc val arg))
                (_ : event loc val arg),
              Prop),
       Prop

