  sa_new%_function_scope N%_nat_scope step%_function_scope
iters =
fun loc val arg : Type =>
fix iters (w : nat) (tr : list (event loc val arg)) {struct tr} : list nat :=
  match tr return list nat with
  | @nil _ => @nil nat
  | @cons _ e tr' =>
      match e return list nat with
      | Read _ _ _ _ _ => iters w tr'
      | Write _ _ _ _ _ => iters w tr'
      | HistoryRead _ _ _ _ _ => iters w tr'
      | Shared _ _ _ _ _ _ _ _ => iters w tr'
      | DeviceRead _ _ _ _ _ _ => iters w tr'
      | DeviceWrite _ _ _ _ _ _ => iters w tr'
      | DeviceCovered _ _ _ _ => iters w tr'
      | Own _ _ _ _ => iters w tr'
      | Enter _ _ _ => iters w tr'
      | Exit _ _ _ => iters w tr'
      | Workshare _ _ _ _ => iters w tr'
      | Iter _ _ _ w' i =>
          match PeanoNat.Nat.eqb w w' return list nat with
          | true => @cons nat i (iters w tr')
          | false => iters w tr'
          end
      | Barrier _ _ _ => iters w tr'
      end
  end
     : forall (loc val arg : Type) (_ : nat) (_ : list (event loc val arg)),
       list nat

Arguments iters (loc val arg)%_type_scope w%_nat_scope tr%_list_scope
obl_chunk_cover =
fun (loc arr val arg : Type) (array_of : forall _ : loc, arr)
  (init : forall _ : loc, val)
  (sa_new : forall (_ : shared_action_kind) (_ : arg) (_ : val), option val)
  (N team_size : nat) (cls : forall (_ : nat) (_ : arr), sharing_class)
  (space : forall _ : nat, list nat) (split_by_tid : forall _ : nat, bool)
  (chunk : forall (_ : nat) (_ : nat), list nat)
  (step : forall (_ : nat) (_ : list (event loc val arg))
            (_ : event loc val arg),
          Prop)
  (done : forall (_ : nat) (_ : list (event loc val arg)), Prop) =>
and
  (forall (w : nat) (_ : @eq bool (split_by_tid w) true),
   and
     (forall i : nat,
      iff (@List.In nat i (space w))
        (@ex nat (fun t : nat => and (lt t N) (@List.In nat i (chunk w t)))))
     (and
        (forall (t t' i : nat) (_ : lt t N) (_ : lt t' N)
           (_ : not (@eq nat t t')) (_ : @List.In nat i (chunk w t)),
         not (@List.In nat i (chunk w t')))
        (forall t : nat, @List.NoDup nat (chunk w t))))
  (forall (X : run loc val arg) (rf : rf_map) (t w : nat)
     (_ : model_run loc val arg init sa_new team_size space split_by_tid step
            done X rf)
     (_ : complete loc val arg N done X)
     (_ : all_fit loc arr val arg array_of N cls X) 
     (_ : lt t N) (_ : @eq bool (split_by_tid w) true)
     (_ : @List.In (event loc val arg) (Workshare loc val arg w)
            (proj loc val arg X t)),
   @eq (list nat) (iters loc val arg w (proj loc val arg X t)) (chunk w t))
     : forall (loc arr val arg : Type) (_ : forall _ : loc, arr)
         (_ : forall _ : loc, val)
         (_ : forall (_ : shared_action_kind) (_ : arg) (_ : val), option val)
         (_ : nat) (_ : nat) (_ : forall (_ : nat) (_ : arr), sharing_class)
         (_ : forall _ : nat, list nat) (_ : forall _ : nat, bool)
         (_ : forall (_ : nat) (_ : nat), list nat)
         (_ : forall (_ : nat) (_ : list (event loc val arg))
                (_ : event loc val arg),
              Prop)
         (_ : forall (_ : nat) (_ : list (event loc val arg)), Prop),
       Prop

